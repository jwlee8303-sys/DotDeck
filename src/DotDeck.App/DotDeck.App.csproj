<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DotDeck</AssemblyName>
    <RootNamespace>DotDeck.App</RootNamespace>
    <!-- Program.Main dispatches AI CLI helper modes (scope guard, heartbeat) before starting WPF. -->
    <StartupObject>DotDeck.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated from Assets\Icons\Source\*.svg by build/icons/generate-icons.ps1. Velopack copies it to the root launcher. -->
    <ApplicationIcon>Assets\Icons\DotDeck.ico</ApplicationIcon>
    <!-- Required by LibraryImport source-generated P/Invoke marshalling. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Release publish is a folder (DotDeck.exe next to its DLLs and the runtime), never a single file: build/package.ps1
       publishes self-contained with PublishSingleFile=false and Velopack installs that folder as current\. -->
  <PropertyGroup>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <Target Name="RejectSingleFilePublish" BeforeTargets="PrepareForPublish" Condition="'$(PublishSingleFile)' == 'true'">
    <Error Text="DotDeck is published as a folder (current\DotDeck.exe + DLLs + runtime). Use build/package.ps1 or -p:PublishSingleFile=false." />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dirkster.AvalonDock" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS" />
    <PackageReference Include="Dirkster.AvalonDock.Serializer.Xml" />
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Editor\Highlighting\*.xshd" />
    <!-- Terminal page (xterm.js + DotDeck page), served from memory on a virtual host; see TerminalAssets. -->
    <EmbeddedResource Include="Assets\Terminal\**\*" LogicalName="Terminal/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Window.Icon (pack URI) and the tray symbols for a light / dark taskbar (TrayIcon). -->
    <Resource Include="Assets\Icons\DotDeck.ico" />
    <EmbeddedResource Include="Assets\Icons\tray-on-*.ico" LogicalName="Tray/%(Filename)%(Extension)" />
    <!-- File/folder icons generated by build/icons/update-file-icons.ps1 (Material Icon Theme + DotDeck's own).
         Loose DrawingImage XAML read on first use, so they must not be compiled as pages. -->
    <Page Remove="Assets\FileIcons\**\*.xaml" />
    <EmbeddedResource Include="Assets\FileIcons\icons\*.xaml" LogicalName="FileIcons/icons/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\FileIcons\material-icons.json" LogicalName="FileIcons/material-icons.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\FileIcons\LICENSE-material-icon-theme.txt" Link="licenses\LICENSE-material-icon-theme.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotDeck.Core\DotDeck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotDeck.App.Tests" />
  </ItemGroup>
</Project>
