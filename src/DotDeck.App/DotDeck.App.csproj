<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DotDeck</AssemblyName>
    <RootNamespace>DotDeck.App</RootNamespace>
    <!-- Program.Main dispatches AI CLI helper modes (scope guard, heartbeat) before starting WPF. -->
    <StartupObject>DotDeck.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Required by LibraryImport source-generated P/Invoke marshalling. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Single-file publish: bundle native WPF/WebView2 libraries and drop reference docs so only DotDeck.exe ships. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dirkster.AvalonDock" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS" />
    <PackageReference Include="Dirkster.AvalonDock.Serializer.Xml" />
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Editor\Highlighting\*.xshd" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotDeck.Core\DotDeck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotDeck.App.Tests" />
  </ItemGroup>
</Project>
