<UserControl x:Class="DotDeck.App.Views.Approvals.ApprovalPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DotDeck.App.Converters"
             x:Name="Root" Focusable="False">
    <!-- The approval area of one session (ApprovalItemViewModel): AI 모니터 section and notification card.
         Y/N answer only while the keyboard focus is inside this area. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:FalseToVisibleConverter x:Key="FalseToVisible" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Y" Command="{Binding AllowCommand}" />
        <KeyBinding Key="N" Command="{Binding DenyCommand}" />
    </UserControl.InputBindings>
    <StackPanel>
        <!-- Waiting / handed to the terminal -->
        <StackPanel Visibility="{Binding HasRequest, Converter={StaticResource BoolToVisible}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource DD.Brush.Warning}"
                           Text="{Binding WaitingText}" />
                <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding CliText, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="·" /> <Run Text="{Binding ToolText, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
            <DockPanel Margin="0,2,0,0">
                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="4,0" VerticalAlignment="Top" Command="{Binding ToggleExpandedCommand}"
                        Visibility="{Binding IsCommandLong, Converter={StaticResource BoolToVisible}}" ToolTip="전체 명령 보기/접기">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="펼치기" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="Content" Value="접기" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Grid>
                    <TextBlock FontFamily="{DynamicResource DD.Font.Editor}" Text="{Binding CommandSummary}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding CommandText}" Visibility="{Binding IsExpanded, Converter={StaticResource FalseToVisible}}" />
                    <TextBox FontFamily="{DynamicResource DD.Font.Editor}" Text="{Binding CommandText, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}"
                             AutomationProperties.Name="요청 명령 전체" />
                </Grid>
            </DockPanel>
            <TextBlock Style="{StaticResource DD.Text.Secondary}" TextTrimming="CharacterEllipsis" Text="{Binding FolderText, StringFormat=작업 폴더: {0}}"
                       ToolTip="{Binding FolderText}" Visibility="{Binding HasFolder, Converter={StaticResource BoolToVisible}}" />
            <TextBlock TextWrapping="Wrap" Style="{StaticResource DD.Text.Secondary}" Text="{Binding NoteText}"
                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVisible}}" />
            <WrapPanel Margin="0,4,0,0">
                <Button Content="허용" MinWidth="56" Margin="0,0,6,2" Command="{Binding AllowCommand}" ToolTip="이번 한 번 허용 (Y)"
                        Visibility="{Binding CanAnswer, Converter={StaticResource BoolToVisible}}" />
                <Button Content="거부" MinWidth="56" Margin="0,0,6,2" Command="{Binding DenyCommand}" ToolTip="이번 한 번 거부 (N)"
                        Visibility="{Binding CanAnswer, Converter={StaticResource BoolToVisible}}" />
                <Button Content="터미널로 이동" Margin="0,0,6,2" Command="{Binding GoToTerminalCommand}"
                        Visibility="{Binding ShowGoToTerminal, ElementName=Root, Converter={StaticResource BoolToVisible}}" />
                <Button Content="열기" Margin="0,0,6,2" Command="{Binding OpenCommand}" ToolTip="DotDeck을 열고 AI 모니터에서 이 세션을 보여 줍니다"
                        Visibility="{Binding ShowOpen, ElementName=Root, Converter={StaticResource BoolToVisible}}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource DD.Text.Secondary}" Text="{Binding QueueText}"
                       Visibility="{Binding QueueText, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
        <!-- Last result -->
        <TextBlock Style="{StaticResource DD.Text.Secondary}" Text="{Binding LastResultText}"
                   Visibility="{Binding HasLastResult, Converter={StaticResource BoolToVisible}}" />
    </StackPanel>
</UserControl>
