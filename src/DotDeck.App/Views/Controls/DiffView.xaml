<UserControl x:Class="DotDeck.App.Views.Controls.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:DotDeck.Core.Documents;assembly=DotDeck.Core"
             x:Name="Root">
    <!-- Unified line diff. ItemsSource: IEnumerable<DiffLine> (usually TextDiff.Compact()). -->
    <ListBox ItemsSource="{Binding Lines, ElementName=Root}"
             Background="{DynamicResource DD.Brush.Editor.Background}" BorderThickness="0"
             FontFamily="{DynamicResource DD.Font.Editor}" FontSize="{DynamicResource DD.FontSize.Editor}"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
             ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type core:DiffLine}">
                <Border x:Name="Row" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding OldLineNumber}" TextAlignment="Right" Margin="0,0,6,0"
                                   Foreground="{DynamicResource DD.Brush.Editor.LineNumber}" />
                        <TextBlock Grid.Column="1" Text="{Binding NewLineNumber}" TextAlignment="Right" Margin="0,0,6,0"
                                   Foreground="{DynamicResource DD.Brush.Editor.LineNumber}" />
                        <TextBlock x:Name="Marker" Grid.Column="2" Text=" " Foreground="{DynamicResource DD.Brush.Editor.Text}" />
                        <TextBlock x:Name="Body" Grid.Column="3" Text="{Binding Text}" Foreground="{DynamicResource DD.Brush.Editor.Text}"
                                   xml:space="preserve" />
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffLineKind.Inserted}">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource DD.Brush.Diff.Inserted}" />
                        <Setter TargetName="Marker" Property="Text" Value="+" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffLineKind.Deleted}">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource DD.Brush.Diff.Deleted}" />
                        <Setter TargetName="Marker" Property="Text" Value="-" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffLineKind.Gap}">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource DD.Brush.Diff.Gap}" />
                        <Setter TargetName="Body" Property="Text" Value="{Binding Text, StringFormat='⋯ 변경 없는 {0}줄'}" />
                        <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource DD.Brush.Text.Secondary}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
