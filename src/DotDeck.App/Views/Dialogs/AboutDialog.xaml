<Window x:Class="DotDeck.App.Views.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DotDeck 정보" Width="720" Height="560" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource DD.Brush.Panel.Background}"
        Foreground="{DynamicResource DD.Brush.Text}"
        FontFamily="{DynamicResource DD.Font.Ui}"
        FontSize="{DynamicResource DD.FontSize.Ui}">
    <DockPanel Margin="16,14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="VersionText" FontSize="16" />
            <TextBlock Style="{StaticResource DD.Text.Secondary}" Margin="0,2,0,0" Text="개발 환경 설정 파일·문서 에디터" />
            <TextBlock x:Name="PathsText" Style="{StaticResource DD.Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock Margin="0,14,0,6" Text="서드파티 고지 (THIRD-PARTY-NOTICES.txt)" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="라이선스 폴더 열기" MinWidth="120" Click="OnOpenFolderClick" x:Name="OpenFolderButton" />
            <Button Content="닫기" IsCancel="True" IsDefault="True" MinWidth="80" Margin="8,0,0,0" />
        </StackPanel>
        <!-- Read-only: the notices are shown as shipped. -->
        <TextBox x:Name="NoticesBox" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="{DynamicResource DD.Font.Editor}" AutomationProperties.Name="서드파티 고지" />
    </DockPanel>
</Window>
