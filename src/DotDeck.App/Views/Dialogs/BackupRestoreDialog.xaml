<Window x:Class="DotDeck.App.Views.Dialogs.BackupRestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DotDeck.App.Views.Controls"
        Title="{Binding Title}"
        Width="1000" Height="640" MinWidth="600" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource DD.Brush.Panel.Background}"
        Foreground="{DynamicResource DD.Brush.Text}"
        FontFamily="{DynamicResource DD.Font.Ui}"
        FontSize="{DynamicResource DD.FontSize.Ui}">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Style="{StaticResource DD.Text.Secondary}"
                   Text="복원하면 현재 디스크 내용을 먼저 백업한 뒤 선택한 백업으로 바꿉니다. (−: 현재 편집 내용, +: 백업)" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="복원" MinWidth="88" IsDefault="True" Command="{Binding RestoreCommand}" />
            <Button Content="닫기" MinWidth="88" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox Grid.Column="0" Margin="0,0,8,0" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2" ToolTip="{Binding Set.Directory}">
                            <TextBlock Text="{Binding When}" />
                            <TextBlock Style="{StaticResource DD.Text.Secondary}">
                                <Run Text="{Binding Reason, Mode=OneWay}" /> · <Run Text="{Binding Size, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="1" BorderBrush="{DynamicResource DD.Brush.Border}" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="👁 diff 표시 / 가리기" Command="{Binding RevealCommand}" HorizontalAlignment="Right" />
                    <TextBlock DockPanel.Dock="Top" Margin="6,4" Text="{Binding Message}" TextWrapping="Wrap" />
                    <controls:DiffView Lines="{Binding Lines}" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
