<Window x:Class="DotDeck.App.Views.Dialogs.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource DD.Brush.Panel.Background}"
        Foreground="{DynamicResource DD.Brush.Text}"
        FontFamily="{DynamicResource DD.Font.Ui}"
        FontSize="{DynamicResource DD.FontSize.Ui}">
    <StackPanel Margin="16,14">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <CheckBox x:Name="ApplyToAllBox" Margin="0,12,0,0" Visibility="Collapsed" Foreground="{DynamicResource DD.Brush.Text}" />
        <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" />
    </StackPanel>
</Window>
