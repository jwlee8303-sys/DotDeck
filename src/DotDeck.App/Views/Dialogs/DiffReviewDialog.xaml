<Window x:Class="DotDeck.App.Views.Dialogs.DiffReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DotDeck.App.Views.Controls"
        xmlns:conv="clr-namespace:DotDeck.App.Converters"
        Title="{Binding Title}"
        Width="980" Height="640" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource DD.Brush.Panel.Background}"
        Foreground="{DynamicResource DD.Brush.Text}"
        FontFamily="{DynamicResource DD.Font.Ui}"
        FontSize="{DynamicResource DD.FontSize.Ui}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </Window.Resources>

    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,8" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Content="{Binding SkipLabel}"
                      IsChecked="{Binding SkipNextTime}"
                      Visibility="{Binding SkipLabel, Converter={StaticResource NullToCollapsed}}" />
            <ItemsControl ItemsSource="{Binding Choices}" HorizontalAlignment="Right">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" MinWidth="88" Margin="8,0,0,0"
                                IsDefault="{Binding IsDefault}" IsCancel="{Binding IsCancel}"
                                Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox Grid.Column="0" Width="240" Margin="0,0,8,0"
                     ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                     Visibility="{Binding ShowsFileList, Converter={StaticResource BoolToVisible}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2" ToolTip="{Binding Path}">
                            <CheckBox DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Top"
                                      Content="백업 제외"
                                      IsChecked="{Binding IsBackupExcluded}" IsEnabled="{Binding CanAddBackupExclusion}"
                                      Visibility="{Binding CanExcludeBackup, Converter={StaticResource BoolToVisible}}"
                                      ToolTip="체크하면 자동백업 제외항목에 즉시 등록합니다. 해제는 설정 메뉴에서 할 수 있습니다."
                                      AutomationProperties.Name="자동백업 제외" />
                            <StackPanel>
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource DD.Text.Secondary}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="1" BorderBrush="{DynamicResource DD.Brush.Border}" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="👁 비밀값 포함 diff 표시 / 가리기" Command="{Binding SelectedItem.RevealCommand}" HorizontalAlignment="Right"
                            Visibility="{Binding SelectedItem.CanReveal, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed}" />
                    <TextBlock DockPanel.Dock="Top" Margin="6,4" Style="{StaticResource DD.Text.Secondary}"
                               Text="{Binding SelectedItem.Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedItem.Path}" />
                    <controls:DiffView Lines="{Binding SelectedItem.Lines}" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
