<Window x:Class="DotDeck.App.Views.Dialogs.ProjectBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프로젝트 백업" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource DD.Brush.Panel.Background}"
        Foreground="{DynamicResource DD.Brush.Text}"
        FontFamily="{DynamicResource DD.Font.Ui}"
        FontSize="{DynamicResource DD.FontSize.Ui}">
    <StackPanel Margin="16,14">
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="모두 선택" Click="OnSelectAllClick" Padding="8,1" />
            <TextBlock Text="백업할 프로젝트" VerticalAlignment="Center" FontWeight="SemiBold" />
        </DockPanel>
        <Border Margin="0,6,0,0" BorderThickness="1" BorderBrush="{DynamicResource DD.Brush.Border}" MaxHeight="240">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ProjectList" Margin="6,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="0,2" IsChecked="{Binding IsSelected}" ToolTip="{Binding Root}">
                                <TextBlock>
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Foreground="{DynamicResource DD.Brush.Text.Secondary}" Text="{Binding Root, Mode=OneWay}" />
                                </TextBlock>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBlock Text="저장할 폴더" Margin="0,12,0,4" FontWeight="SemiBold" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="찾아보기..." Margin="6,0,0,0" Padding="8,1" Click="OnBrowseClick" />
            <TextBox x:Name="DestinationBox" AutomationProperties.Name="백업 저장 폴더" />
        </DockPanel>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource DD.Text.Secondary}"
                   Text="선택한 프로젝트를 zip 파일 하나로 저장합니다. 비밀 파일(.env, 키 파일 등), 링크, 제외 폴더는 넣지 않습니다." />
        <TextBlock x:Name="ErrorText" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{DynamicResource DD.Brush.Error}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="백업" IsDefault="True" MinWidth="80" Click="OnOkClick" />
            <Button Content="취소" IsCancel="True" MinWidth="80" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
