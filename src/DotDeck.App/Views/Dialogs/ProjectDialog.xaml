<Window x:Class="DotDeck.App.Views.Dialogs.ProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DotDeck.App.Converters"
        Title="{Binding Title}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource DD.Brush.Panel.Background}"
        Foreground="{DynamicResource DD.Brush.Text}"
        FontFamily="{DynamicResource DD.Font.Ui}"
        FontSize="{DynamicResource DD.FontSize.Ui}"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <Window.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:InvertBooleanConverter x:Key="Invert" />
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource DD.Text.Secondary}">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="이름" />
            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditNameAndRoot}" />

            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="폴더" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Root, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditNameAndRoot}" />
            <Button Grid.Row="2" Grid.Column="2" Margin="6,0,0,0" Content="찾아보기..." Command="{Binding BrowseCommand}"
                    IsEnabled="{Binding CanEditNameAndRoot}" />

            <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="색상" />
            <ListBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Colors}"
                     SelectedItem="{Binding SelectedColor}" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="3" />
                        <Setter Property="ToolTip" Value="{Binding Label}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="18" Height="18" BorderThickness="1" BorderBrush="{DynamicResource DD.Brush.Border}"
                                Background="{Binding Hex, TargetNullValue=Transparent}">
                            <TextBlock x:Name="None" Style="{StaticResource DD.Glyph}" FontSize="10" Text="&#xE711;"
                                       Foreground="{DynamicResource DD.Brush.Text.Secondary}" Visibility="Collapsed" />
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Hex}" Value="{x:Null}">
                                <Setter TargetName="None" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="표시" />
            <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                <RadioButton Content="설정·문서 파일만" IsChecked="{Binding IsConfigDocs}" Foreground="{DynamicResource DD.Brush.Text}" Margin="0,0,16,0" />
                <RadioButton Content="모든 파일" IsChecked="{Binding IsConfigDocs, Converter={StaticResource Invert}}" Foreground="{DynamicResource DD.Brush.Text}" />
            </StackPanel>
        </Grid>

        <TextBlock Margin="0,12,0,0" Text="{Binding Error}" Foreground="{DynamicResource DD.Brush.Error}" TextWrapping="Wrap"
                   Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

        <TextBlock Margin="0,12,0,0" Style="{StaticResource DD.Text.Secondary}" TextWrapping="Wrap"
                   Text="프로젝트는 목록에만 등록됩니다. 폴더와 파일은 변경하지 않습니다." />

        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="확인" IsDefault="True" MinWidth="80" Command="{Binding OkCommand}" />
            <Button Content="취소" IsCancel="True" MinWidth="80" Margin="8,0,0,0" Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
