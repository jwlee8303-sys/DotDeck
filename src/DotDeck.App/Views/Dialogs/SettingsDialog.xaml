<Window x:Class="DotDeck.App.Views.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource DD.Brush.Panel.Background}"
        Foreground="{DynamicResource DD.Brush.Text}"
        FontFamily="{DynamicResource DD.Font.Ui}"
        FontSize="{DynamicResource DD.FontSize.Ui}">
    <StackPanel Margin="16,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="테마" VerticalAlignment="Center" />
            <ComboBox x:Name="ThemeBox" Grid.Column="1" Margin="0,3" AutomationProperties.Name="테마">
                <ComboBoxItem Content="다크" Tag="Dark" />
                <ComboBoxItem Content="라이트" Tag="Light" />
            </ComboBox>
            <TextBlock Grid.Row="1" Text="편집기 글꼴 크기" VerticalAlignment="Center" />
            <TextBox x:Name="FontSizeBox" Grid.Row="1" Grid.Column="1" Margin="0,3" AutomationProperties.Name="편집기 글꼴 크기" />
            <TextBlock Grid.Row="2" Text="백업 보관 개수" VerticalAlignment="Center" />
            <TextBox x:Name="RetentionBox" Grid.Row="2" Grid.Column="1" Margin="0,3" AutomationProperties.Name="백업 보관 개수" />
        </Grid>
        <TextBlock x:Name="ErrorText" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{DynamicResource DD.Brush.Error}" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource DD.Text.Secondary}"
                   Text="라이트 테마에서도 구문 강조와 Markdown 미리보기 색은 아직 다크 기준입니다." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="확인" IsDefault="True" MinWidth="80" Click="OnOkClick" />
            <Button Content="취소" IsCancel="True" MinWidth="80" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
