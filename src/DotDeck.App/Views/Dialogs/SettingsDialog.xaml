<Window x:Class="DotDeck.App.Views.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:DotDeck.App.Views.Controls"
        xmlns:editor="clr-namespace:DotDeck.App.Views.Editor"
        xmlns:conv="clr-namespace:DotDeck.App.Converters"
        Title="환경 설정" Width="900" Height="680" MinWidth="640" MinHeight="460" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource DD.Brush.Panel.Background}"
        Foreground="{DynamicResource DD.Brush.Text}"
        FontFamily="{DynamicResource DD.Font.Ui}"
        FontSize="{DynamicResource DD.FontSize.Ui}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource DD.Text.Secondary}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="12,10,12,12">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ErrorText" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{DynamicResource DD.Brush.Error}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="확인" IsDefault="True" MinWidth="80" Click="OnOkClick" />
                <Button Content="취소" IsCancel="True" MinWidth="80" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
        <TabControl x:Name="Tabs">
            <TabItem Header="일반">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="테마" VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemeBox" Grid.Column="1" Margin="0,3" AutomationProperties.Name="테마">
                                <ComboBoxItem Content="다크" Tag="Dark" />
                                <ComboBoxItem Content="라이트" Tag="Light" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="편집기 글꼴 크기" VerticalAlignment="Center" />
                            <TextBox x:Name="FontSizeBox" Grid.Row="1" Grid.Column="1" Margin="0,3" AutomationProperties.Name="편집기 글꼴 크기" />
                        </Grid>
                        <CheckBox x:Name="CloseToTrayBox" Margin="0,10,0,0" Content="창을 닫으면 트레이로 숨기기"
                                  ToolTip="X 버튼으로 닫으면 종료하지 않고 알림 영역(트레이)으로 숨깁니다. 끝내기는 파일 메뉴나 트레이 아이콘 메뉴에서 합니다." />
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource Note}"
                                   Text="라이트 테마에서도 구문 강조와 Markdown 미리보기 색은 아직 다크 기준입니다." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="백업">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="백업 보관 개수" VerticalAlignment="Center" />
                            <TextBox x:Name="RetentionBox" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,3" AutomationProperties.Name="백업 보관 개수" />
                            <TextBlock Grid.Row="1" Text="백업 폴더" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,3" MinWidth="420">
                                <Button DockPanel.Dock="Right" Content="기본값" Margin="4,0,0,0" Padding="6,1" Click="OnDefaultBackupClick" />
                                <Button DockPanel.Dock="Right" Content="찾아보기..." Margin="4,0,0,0" Padding="6,1" Click="OnBrowseBackupClick" />
                                <TextBox x:Name="BackupDirBox" AutomationProperties.Name="백업 폴더" />
                            </DockPanel>
                        </Grid>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Note}"
                                   Text="백업 폴더를 바꾸면 이후 백업부터 새 폴더에 저장됩니다(기존 백업은 옮기지 않음)." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="탐색기">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Margin="0,0,0,4" Text="탐색기 기본 확장자" />
                        <ctl:ExtensionChoicesView x:Name="ExtensionsView" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Note}"
                                   Text="자기 목록을 정하지 않은 프로젝트(전역 기본값 사용)에 적용됩니다." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="AI 승인 요청">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <StackPanel Margin="4,4,0,0">
                        <CheckBox x:Name="ApprovalEnabledBox" Content="승인 요청 감지 사용"
                                  ToolTip="AI CLI가 도구 실행 승인을 기다리면 AI 모니터에 표시하고 바로 응답할 수 있게 합니다." />
                        <StackPanel Orientation="Horizontal" Margin="20,4,0,0" IsEnabled="{Binding IsChecked, ElementName=ApprovalEnabledBox}">
                            <TextBlock Text="CLI별 감지:" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <CheckBox x:Name="DetectClaudeBox" Content="Claude" Margin="0,0,10,0" />
                            <CheckBox x:Name="DetectCodexBox" Content="Codex" Margin="0,0,10,0" />
                            <CheckBox x:Name="DetectAgyBox" Content="agy" />
                        </StackPanel>
                        <StackPanel Margin="20,4,0,0" IsEnabled="{Binding IsChecked, ElementName=ApprovalEnabledBox}">
                            <CheckBox x:Name="ScreenDetectionBox" Content="대체 감지(화면 패턴) 사용"
                                      ToolTip="공식 연결이 없는 세션(Codex 세션, 터미널 탭에서 직접 실행한 CLI)은 터미널 화면의 승인 프롬프트와 출력 정지로 추정합니다." />
                            <CheckBox x:Name="PinWaitingBox" Margin="0,4,0,0" Content="승인 대기 세션을 목록 맨 위로" />
                            <CheckBox x:Name="CardsBox" Margin="0,4,0,0" Content="비활성·트레이 상태에서 알림 카드 표시"
                                      ToolTip="DotDeck이 활성 창이 아니거나 트레이에 있을 때만 화면 오른쪽 아래에 카드를 띄웁니다(포커스를 빼앗지 않음)." />
                            <CheckBox x:Name="CardSoundBox" Margin="20,4,0,0" Content="알림 카드 소리" IsEnabled="{Binding IsChecked, ElementName=CardsBox}" />
                        </StackPanel>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="AI 컨텍스트">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource DD.Text.Secondary}"
                                   Text="AI 모니터 &quot;컨텍스트&quot; 탭의 제안 기준입니다. 토큰은 글자 수로 추정한 값입니다." />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="지침 파일 권장 크기 (토큰)" VerticalAlignment="Center" Margin="0,2,10,2" />
                            <TextBox x:Name="ContextInstructionBox" Grid.Column="1" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="MCP·기타 경고 비율 (%)" VerticalAlignment="Center" Margin="0,2,10,2" />
                            <TextBox x:Name="ContextShareBox" Grid.Row="1" Grid.Column="1" Margin="0,2" />
                            <TextBlock Grid.Row="2" Text="긴 스킬·에이전트 설명 기준 (토큰)" VerticalAlignment="Center" Margin="0,2,10,2" />
                            <TextBox x:Name="ContextDescriptionBox" Grid.Row="2" Grid.Column="1" Margin="0,2" />
                            <TextBlock Grid.Row="3" Text="기본 소모 경고 (토큰)" VerticalAlignment="Center" Margin="0,2,10,2" />
                            <TextBox x:Name="ContextTotalBox" Grid.Row="3" Grid.Column="1" Margin="0,2" />
                            <TextBlock Grid.Row="4" Text="세션 목록 사용률 주황 (%)" VerticalAlignment="Center" Margin="0,2,10,2"
                                       ToolTip="AI 모니터 세션 목록의 컨텍스트 사용률이 이 값 이상이면 주황으로 표시합니다. 토큰 수만 표시할 때는 색을 칠하지 않습니다." />
                            <TextBox x:Name="ContextWarningPercentBox" Grid.Row="4" Grid.Column="1" Margin="0,2" />
                            <TextBlock Grid.Row="5" Text="세션 목록 사용률 빨강 (%)" VerticalAlignment="Center" Margin="0,2,10,2" />
                            <TextBox x:Name="ContextDangerPercentBox" Grid.Row="5" Grid.Column="1" Margin="0,2" />
                        </Grid>
                        <TextBlock Margin="0,12,0,2" FontWeight="SemiBold" Text="Claude 모델별 컨텍스트 창 크기" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource DD.Text.Secondary}"
                                   Text="Claude 상태 표시줄 값이 없을 때(연결 안 됨, 비대화형 세션) 세션 로그에는 창 크기가 없어 사용률을 이 표로 추정합니다. 한 줄에 &quot;모델 이름에 포함된 문자열=토큰&quot;(예: claude-=200000). 여러 줄이 맞으면 가장 긴 문자열이 우선합니다. 비우면 사용률 없이 토큰 수만 표시합니다." />
                        <TextBox x:Name="ContextWindowsBox" Margin="0,4,0,0" Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 FontFamily="{DynamicResource DD.Font.Editor}" />
                        <Expander Margin="0,12,0,0" Header="고급">
                            <StackPanel Margin="4,4,0,0">
                                <CheckBox x:Name="McpDirectMeasureBox" Content="MCP 직접 측정"
                                          ToolTip="켜면 컨텍스트 탭에 [측정]·[전체 측정]이 나타납니다. 누르면 확인 후 MCP 서버를 실제로 실행해 initialize → tools/list만 받고 10초 안에 종료합니다." />
                                <TextBlock Margin="20,2,0,0" TextWrapping="Wrap" Style="{StaticResource DD.Text.Secondary}"
                                           Text="서버 설정의 env·헤더는 측정용 프로세스·요청에 그대로 전달만 하며 화면·로그·캐시에 남기지 않습니다. 캐시에는 서버 이름, 도구 수, 추정 토큰, 측정 시각, 설정 해시만 저장하고 설정이 바뀌면 다시 확인받습니다. OAuth 로그인이 필요한 원격 서버는 측정하지 않습니다." />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="AI 세션 훅" x:Name="SessionHooksTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="기본값으로 되돌리기" Padding="8,1" VerticalAlignment="Top"
                                    Command="{Binding ResetToDefaultsCommand}" ToolTip="DotDeck 기본 훅을 모두 켜고 사용자 추가 훅을 지웁니다" />
                            <TextBlock Style="{StaticResource Note}" VerticalAlignment="Center"
                                       Text="DotDeck으로 시작하는 Claude 세션의 settings.json(--settings)에 들어갈 훅입니다. 바꾼 내용은 이후 새로 시작하는 세션부터 적용되고, 이미 실행 중인 세션은 바뀌지 않습니다." />
                        </DockPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="DotDeck 기본 훅" />
                        <CheckBox Content="도구 실행 가드" IsChecked="{Binding Guard}" AutomationProperties.Name="도구 실행 가드" />
                        <TextBlock Margin="20,1,0,4" Style="{StaticResource Note}" Text="{Binding GuardOffNote}" />
                        <CheckBox Content="승인 훅 (승인 요청 · 승인 실행 확인)" IsChecked="{Binding ApprovalHooks}" AutomationProperties.Name="승인 훅" />
                        <TextBlock Margin="20,1,0,6" Style="{StaticResource Note}" Text="{Binding ApprovalOffNote}" />
                        <Border BorderThickness="1" BorderBrush="{DynamicResource DD.Brush.Border}" Padding="6,4">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="250" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource DD.Text.Secondary}" Text="훅" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource DD.Text.Secondary}" Text="이벤트" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource DD.Text.Secondary}" Text="matcher" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource DD.Text.Secondary}" Text="명령" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource DD.Text.Secondary}" Text="timeout(초) · 상태" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding DefaultHooks}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="250" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Event}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Matcher}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="3" Margin="0,0,8,0" Text="{Binding Command, Mode=OneWay}" IsReadOnly="True"
                                                         FontFamily="{DynamicResource DD.Font.Editor}" ToolTip="{Binding Command}" />
                                                <TextBlock Grid.Column="4" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource DD.Text.Secondary}">
                                                    <Run Text="{Binding Timeout, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding Note, Mode=OneWay}" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="사용자 추가 훅 (DotDeck으로 시작한 Claude 세션에만)" />
                        <TextBlock Margin="0,0,0,4" Style="{StaticResource Note}"
                                   Text="같은 이벤트라도 DotDeck 기본 훅 뒤에 별도 그룹으로 붙어 함께 실행됩니다(기본 훅을 덮어쓰지 않음). ▷ 버튼으로 훅 테스트를 실행합니다." />
                        <editor:HookTable DataContext="{Binding HookTable}" />
                        <DockPanel Margin="0,4,0,0" Visibility="{Binding UserHooksWarning, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource DD.Glyph}" FontSize="12" Margin="0,1,6,0"
                                       Foreground="{DynamicResource DD.Brush.Warning}" Text="&#xE7BA;" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding UserHooksWarning}" />
                        </DockPanel>

                        <Expander Margin="0,12,0,0" Header="세션에 넘길 settings.json 미리보기">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Margin="0,0,0,4" Style="{StaticResource Note}"
                                           Text="{}{세션 ID}는 세션을 시작할 때 정해집니다. 이 미리보기는 프로젝트가 없는 예시 범위로 만들었습니다. 실제 세션에서는 permissions에 프로젝트·읽기 전용 폴더에 따른 차단 경로가 더해집니다." />
                                <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" FontFamily="{DynamicResource DD.Font.Editor}"
                                         Height="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="settings.json 미리보기" />
                            </StackPanel>
                        </Expander>
                        <Expander Margin="0,8,0,0" Header="함께 실행되는 사용자 전역 훅 (참고)">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource Note}" Text="{Binding GlobalHooksNote}" />
                                <TextBlock Style="{StaticResource Note}" Text="{Binding GlobalSettingsPath, StringFormat=파일: {0}}" />
                                <TextBlock Style="{StaticResource Note}" Text="프로젝트의 .claude/settings.json · settings.local.json에 있는 훅도 함께 실행됩니다." />
                                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding GlobalHooks}" Focusable="False"
                                              Visibility="{Binding HasGlobalHooks, Converter={StaticResource BoolToVisible}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Event}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Matcher}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Command}" FontFamily="{DynamicResource DD.Font.Editor}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
