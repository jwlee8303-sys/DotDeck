<Window x:Class="DotDeck.App.Views.Dialogs.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource DD.Brush.Panel.Background}"
        Foreground="{DynamicResource DD.Brush.Text}"
        FontFamily="{DynamicResource DD.Font.Ui}"
        FontSize="{DynamicResource DD.FontSize.Ui}"
        FocusManager.FocusedElement="{Binding ElementName=InputBox}">
    <StackPanel Margin="16,14">
        <TextBlock x:Name="PromptText" Style="{StaticResource DD.Text.Secondary}" Margin="0,0,0,6" TextWrapping="Wrap" />
        <TextBox x:Name="InputBox" TextChanged="OnTextChanged" />
        <TextBlock x:Name="ErrorText" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{DynamicResource DD.Brush.Error}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="확인" IsDefault="True" MinWidth="80" Click="OnOkClick" />
            <Button Content="취소" IsCancel="True" MinWidth="80" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
