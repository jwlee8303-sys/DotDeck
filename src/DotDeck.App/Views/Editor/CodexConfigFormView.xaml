<UserControl x:Class="DotDeck.App.Views.Editor.CodexConfigFormView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:DotDeck.App.ViewModels.Editor" xmlns:local="clr-namespace:DotDeck.App.Views.Editor"
 xmlns:conv="clr-namespace:DotDeck.App.Converters">
 <UserControl.Resources>
  <conv:InvertBooleanConverter x:Key="Inverse" />
  <DataTemplate DataType="{x:Type vm:CodexFieldViewModel}">
   <StackPanel Margin="8,6">
    <DockPanel><Button DockPanel.Dock="Right" Content="설정 해제" Command="{Binding ResetCommand}" Margin="8,0,0,0" />
     <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,3" />
    <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Value" IsEditable="True" Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
      IsEnabled="{Binding IsComplex, Converter={StaticResource Inverse}}">
     <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="ToolTip" Value="{Binding Description}" /></Style></ComboBox.ItemContainerStyle>
    </ComboBox>
    <TextBlock Text="{Binding Default}" Foreground="{DynamicResource DD.Brush.Text.Secondary}" Margin="0,3" />
    <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource DD.Brush.Warning}" TextWrapping="Wrap" />
   </StackPanel>
  </DataTemplate>
 </UserControl.Resources>
 <DockPanel Margin="10">
  <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Foreground="{DynamicResource DD.Brush.Warning}" TextWrapping="Wrap" />
  <TabControl>
   <TabItem Header="모델"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Models}" /></ScrollViewer></TabItem>
   <TabItem Header="권한·샌드박스"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Permissions}" /></ScrollViewer></TabItem>
   <TabItem Header="프로필">
    <DockPanel>
     <StackPanel DockPanel.Dock="Left" Width="210" Margin="0,8,12,0">
      <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinHeight="150" MaxHeight="300" />
      <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="새 프로필 또는 변경할 이름" Margin="0,6" />
      <WrapPanel><Button Content="추가" Command="{Binding AddProfileCommand}" /><Button Content="삭제" Command="{Binding DeleteProfileCommand}" /><Button Content="이름 변경" Command="{Binding RenameProfileCommand}" /></WrapPanel>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{x:Static vm:CodexConfigFormViewModel.ProfileNotice}" TextWrapping="Wrap" Margin="8" /><ItemsControl ItemsSource="{Binding ProfileFields}" /></StackPanel></ScrollViewer>
    </DockPanel>
   </TabItem>
   <TabItem Header="MCP 서버">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <DataGrid ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="210">
      <DataGrid.Columns>
       <DataGridTextColumn Header="이름" Binding="{Binding Name}" IsReadOnly="True" />
       <DataGridTextColumn Header="command" Binding="{Binding Command, UpdateSourceTrigger=LostFocus}" Width="*" />
       <DataGridTextColumn Header="인수 개수" Binding="{Binding Args.Values.Count}" IsReadOnly="True" />
       <DataGridCheckBoxColumn Header="활성(일부=미설정)" IsThreeState="True" Binding="{Binding Enabled}" />
      </DataGrid.Columns>
     </DataGrid>
     <DockPanel Margin="0,6"><TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" Width="180" DockPanel.Dock="Left" /><WrapPanel><Button Content="추가" Command="{Binding AddServerCommand}" /><Button Content="삭제" Command="{Binding DeleteServerCommand}" /><Button Content="이름 변경" Command="{Binding RenameServerCommand}" /></WrapPanel></DockPanel>
     <TextBlock Text="인수 (args) — 각 항목을 별도로 전달합니다." Margin="0,8" />
     <ItemsControl ItemsSource="{Binding SelectedServer.Args.Rows}"><ItemsControl.ItemTemplate><DataTemplate>
      <DockPanel Margin="0,2"><WrapPanel DockPanel.Dock="Right">
       <Button Content="↑" Command="{Binding DataContext.SelectedServer.Args.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
       <Button Content="↓" Command="{Binding DataContext.SelectedServer.Args.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
       <Button Content="삭제" Command="{Binding DataContext.SelectedServer.Args.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
      </WrapPanel><TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" /></DockPanel>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Button Content="인수 추가" Command="{Binding SelectedServer.Args.AddCommand}" HorizontalAlignment="Left" />
     <TextBlock Text="환경변수 (env) — 비밀 이름의 값은 기본 가림이며 눈 아이콘으로 표시·편집합니다." TextWrapping="Wrap" Margin="0,10,0,5" />
     <ItemsControl ItemsSource="{Binding SelectedServer.Env.Rows}"><ItemsControl.ItemTemplate><DataTemplate>
      <DockPanel Margin="0,2">
       <Button DockPanel.Dock="Right" Content="삭제" Command="{Binding DataContext.SelectedServer.Env.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
       <TextBox DockPanel.Dock="Left" Width="180" Text="{Binding Key, UpdateSourceTrigger=LostFocus}" />
       <local:SecretValueEditor Value="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsSecret="{Binding IsSecret}" />
      </DockPanel>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Button Content="환경변수 추가" Command="{Binding SelectedServer.Env.AddCommand}" HorizontalAlignment="Left" />
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="프로젝트 신뢰">
    <DockPanel>
     <StackPanel DockPanel.Dock="Left" Width="300" Margin="0,8,12,0">
      <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" MinHeight="160" />
      <TextBox Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="프로젝트 경로" Margin="0,6" />
      <WrapPanel><Button Content="폴더 선택" Command="{Binding BrowseProjectCommand}" /><Button Content="추가" Command="{Binding AddProjectCommand}" /><Button Content="경로 변경" Command="{Binding RenameProjectCommand}" /><Button Content="제거" Command="{Binding DeleteProjectCommand}" /></WrapPanel>
     </StackPanel>
     <ItemsControl ItemsSource="{Binding TrustFields}" />
    </DockPanel>
   </TabItem>
   <TabItem Header="기타(고급)"><local:AdvancedTomlView DataContext="{Binding Advanced}" /></TabItem>
  </TabControl>
 </DockPanel>
</UserControl>
