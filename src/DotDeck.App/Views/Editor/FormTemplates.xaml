<ResourceDictionary x:Class="DotDeck.App.Views.Editor.FormTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DotDeck.App.ViewModels.Editor"
                    xmlns:conv="clr-namespace:DotDeck.App.Converters">

    <BooleanToVisibilityConverter x:Key="FormBoolToVisible" />
    <conv:FalseToVisibleConverter x:Key="FormFalseToVisible" />
    <conv:NullToCollapsedConverter x:Key="FormNullToCollapsed" />
    <conv:EmptyToVisibleConverter x:Key="FormEmptyToVisible" />
    <conv:InvertBooleanConverter x:Key="FormInvert" />

    <!-- Grey hint drawn over an empty text box. -->
    <Style x:Key="FormPlaceholder" TargetType="TextBlock" BasedOn="{StaticResource DD.Text.Secondary}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Margin" Value="5,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="FontStyle" Value="Italic" />
    </Style>

    <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource DD.Text.Secondary}">
        <Setter Property="Margin" Value="0,10,0,4" />
    </Style>

    <Style x:Key="FormSection" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,6" />
        <Setter Property="Foreground" Value="{DynamicResource DD.Brush.Text}" />
    </Style>

    <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,4,6,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ▾ button that opens a menu of suggestions; the menu items carry the command. -->
    <Style x:Key="DropButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
        <Setter Property="Content" Value="&#xE70D;" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <EventSetter Event="Click" Handler="OnDropButtonClick" />
    </Style>

    <DataTemplate x:Key="RowTools">
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource RowButton}" ToolTip="위로"
                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                <TextBlock Style="{StaticResource DD.Glyph}" FontSize="10" Text="&#xE70E;" />
            </Button>
            <Button Style="{StaticResource RowButton}" ToolTip="아래로"
                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                <TextBlock Style="{StaticResource DD.Glyph}" FontSize="10" Text="&#xE70D;" />
            </Button>
            <Button Style="{StaticResource RowButton}" ToolTip="삭제"
                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                <TextBlock Style="{StaticResource DD.Glyph}" FontSize="10" Text="&#xE711;" />
            </Button>
        </StackPanel>
    </DataTemplate>

    <!-- agents/*.md, skills/*/SKILL.md -->
    <DataTemplate DataType="{x:Type vm:FrontmatterFormViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,4,16,16" MaxWidth="900" HorizontalAlignment="Left" MinWidth="420">
                <TextBlock Style="{StaticResource FormLabel}" Text="name" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource FormLabel}" Text="description" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="60" MaxHeight="200" VerticalScrollBarVisibility="Auto" />

                <StackPanel Visibility="{Binding IsAgent, Converter={StaticResource FormBoolToVisible}}">
                    <TextBlock Style="{StaticResource FormLabel}" Text="tools (쉼표로 구분, 비우면 모든 도구)" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DropButton}" ToolTip="도구 추가" Tag="{Binding Tools}"
                                CommandParameter="{Binding AddToolCommand}" />
                        <TextBox Text="{Binding ToolList, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock Style="{StaticResource FormLabel}" Text="model (비우면 기본값)" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DropButton}" ToolTip="모델 선택" Tag="{Binding Models}"
                                CommandParameter="{Binding SetModelCommand}" />
                        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource FormLabel}" Text="본문 (Markdown)" />
                <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" MinHeight="240" VerticalScrollBarVisibility="Auto"
                         FontFamily="{DynamicResource DD.Font.Editor}" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Claude Code settings.json -->
    <DataTemplate DataType="{x:Type vm:SettingsFormViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,0,16,16">
                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding RoleSummary}" />
                <ItemsControl ItemsSource="{Binding RoleNotes}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource DD.Text.Secondary}" TextWrapping="Wrap" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding ScopeIssues}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3,0,0">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource DD.Glyph}" FontSize="12" Margin="0,1,6,0"
                                           Foreground="{DynamicResource DD.Brush.Warning}" Text="&#xE7BA;" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding Message}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource DD.Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="폼이 다루지 않는 키는 그대로 보존됩니다. 폼에서 고치면 JSON이 2칸 들여쓰기로 다시 정렬됩니다." />

                <TextBlock Style="{StaticResource FormSection}" Text="권한 (permissions)" />
                <TextBlock Style="{StaticResource DD.Text.Secondary}" TextWrapping="Wrap"
                           Text="[종류] [도구] [인수] — 인수를 비우면 도구 전체에 적용합니다. 줄을 선택하면 속성 창에 작성법이 표시됩니다." />
                <DockPanel Margin="0,4,0,4">
                    <Button DockPanel.Dock="Left" Style="{StaticResource RowButton}" Margin="0,0,6,0"
                            Command="{Binding RefreshMcpCommand}" ToolTip="MCP 설정 파일을 다시 읽습니다(서버는 실행하지 않음)">
                        <TextBlock Style="{StaticResource DD.Glyph}" FontSize="10" Text="&#xE72C;" />
                    </Button>
                    <TextBlock Style="{StaticResource DD.Text.Secondary}" VerticalAlignment="Center" Text="{Binding McpStatus}"
                               ToolTip="{Binding McpDetails}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Permissions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,3" PreviewGotKeyboardFocus="OnRowFocus">
                                <ContentPresenter DockPanel.Dock="Right" ContentTemplate="{StaticResource RowTools}" Content="{Binding}" />
                                <DockPanel DockPanel.Dock="Left" Width="80" Margin="0,0,6,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource DropButton}" ToolTip="종류 (deny &gt; ask &gt; allow 순으로 우선)"
                                            Tag="{Binding DataContext.PermissionKinds, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding SetKindCommand}" />
                                    <TextBox Text="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <Grid>
                                    <!-- Parsed rule: tool + argument -->
                                    <DockPanel Visibility="{Binding IsParsed, Converter={StaticResource FormBoolToVisible}}">
                                        <DockPanel DockPanel.Dock="Left" Width="220" Margin="0,0,6,0">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource DropButton}" ToolTip="도구 선택"
                                                    Tag="{Binding DataContext.ToolChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding SetToolCommand}" />
                                            <Grid>
                                                <TextBox Text="{Binding Tool, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding ToolDescription}" />
                                                <TextBlock Style="{StaticResource FormPlaceholder}" Text="도구 (예: Bash)"
                                                           Visibility="{Binding Tool, Converter={StaticResource FormEmptyToVisible}}" />
                                            </Grid>
                                        </DockPanel>
                                        <Grid>
                                            <TextBox Text="{Binding Argument, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding ToolDescription}"
                                                     FontFamily="{DynamicResource DD.Font.Editor}" />
                                            <TextBlock Style="{StaticResource FormPlaceholder}" Text="{Binding ArgumentPlaceholder}"
                                                       Visibility="{Binding Argument, Converter={StaticResource FormEmptyToVisible}}" />
                                        </Grid>
                                    </DockPanel>
                                    <!-- Rule the form cannot split: one text, saved as it is -->
                                    <TextBox Visibility="{Binding IsParsed, Converter={StaticResource FormFalseToVisible}}"
                                             Text="{Binding Tool, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource DD.Font.Editor}"
                                             ToolTip="형식을 해석할 수 없는 규칙입니다. 고치지 않으면 원문 그대로 저장합니다." />
                                </Grid>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource AddButton}" Content="+ allow" Command="{Binding AddPermissionCommand}" CommandParameter="allow" />
                    <Button Style="{StaticResource AddButton}" Content="+ ask" Command="{Binding AddPermissionCommand}" CommandParameter="ask" />
                    <Button Style="{StaticResource AddButton}" Content="+ deny" Command="{Binding AddPermissionCommand}" CommandParameter="deny" />
                </StackPanel>

                <TextBlock Style="{StaticResource FormSection}" Text="훅 (hooks)" />
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource DD.Text.Secondary}" Text="이벤트" />
                    <TextBlock Grid.Column="1" Style="{StaticResource DD.Text.Secondary}" Text="matcher" />
                    <TextBlock Grid.Column="2" Style="{StaticResource DD.Text.Secondary}" Text="command" />
                    <TextBlock Grid.Column="3" Style="{StaticResource DD.Text.Secondary}" Text="timeout(초)" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Hooks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,3" PreviewGotKeyboardFocus="OnRowFocus">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Margin="0,0,6,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource DropButton}" ToolTip="이벤트 선택"
                                                Tag="{Binding DataContext.HookEventChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding SetEventCommand}" />
                                        <TextBox Text="{Binding Event, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding EventDescription}" />
                                    </DockPanel>
                                    <DockPanel Grid.Column="1" Margin="0,0,6,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Click="OnMatcherClick"
                                                IsEnabled="{Binding UsesMatcher}" ToolTip="목록에서 고르기 (여러 개 선택 가능)">
                                            <TextBlock Style="{StaticResource DD.Glyph}" FontSize="10" Text="&#xE762;" />
                                        </Button>
                                        <Grid>
                                            <TextBox x:Name="MatcherBox" Text="{Binding Matcher, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding MatcherPlaceholder}" />
                                            <TextBlock Style="{StaticResource FormPlaceholder}" Text="{Binding MatcherPlaceholder}"
                                                       Visibility="{Binding Matcher, Converter={StaticResource FormEmptyToVisible}}" />
                                        </Grid>
                                    </DockPanel>
                                    <TextBox Grid.Column="2" Margin="0,0,6,0" Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsCommandHook, Mode=OneWay, Converter={StaticResource FormInvert}}"
                                             ToolTip="{Binding CommandToolTip}" FontFamily="{DynamicResource DD.Font.Editor}" />
                                    <TextBox Grid.Column="3" Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="4,0,0,0">
                                        <Button Style="{StaticResource RowButton}" ToolTip="훅 테스트 실행" IsEnabled="{Binding IsCommandHook, Mode=OneWay}"
                                                Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <TextBlock Style="{StaticResource DD.Glyph}" FontSize="10" Text="&#xE768;" />
                                        </Button>
                                        <ContentPresenter ContentTemplate="{StaticResource RowTools}" Content="{Binding}" />
                                    </StackPanel>
                                </Grid>
                                <DockPanel Margin="0,2,0,0" Visibility="{Binding MatcherWarning, Converter={StaticResource FormNullToCollapsed}}">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource DD.Glyph}" FontSize="12" Margin="0,1,6,0"
                                               Foreground="{DynamicResource DD.Brush.Warning}" Text="&#xE7BA;" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding MatcherWarning}" />
                                </DockPanel>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding UsesMatcher}" Value="False">
                                    <Setter TargetName="MatcherBox" Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource AddButton}" Content="+ 훅 추가" Command="{Binding AddHookCommand}" CommandParameter="PreToolUse" />

                <TextBlock Style="{StaticResource FormSection}" Text="환경 변수 (env)" />
                <ItemsControl ItemsSource="{Binding Env}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,3" PreviewGotKeyboardFocus="OnRowFocus">
                                <ContentPresenter DockPanel.Dock="Right" ContentTemplate="{StaticResource RowTools}" Content="{Binding}" />
                                <TextBox DockPanel.Dock="Left" Width="220" Margin="0,0,6,0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource AddButton}" Content="+ 변수 추가" Command="{Binding AddEnvCommand}" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
