<ResourceDictionary x:Class="DotDeck.App.Views.Editor.FormTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DotDeck.App.ViewModels.Editor"
                    xmlns:conv="clr-namespace:DotDeck.App.Converters"
                    xmlns:local="clr-namespace:DotDeck.App.Views.Editor">

    <ResourceDictionary.MergedDictionaries>
        <local:FormControls />
    </ResourceDictionary.MergedDictionaries>

    <!-- agents/*.md, skills/*/SKILL.md -->
    <DataTemplate DataType="{x:Type vm:CodexConfigFormViewModel}">
        <local:CodexConfigFormView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TomlFormViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" MaxHeight="300" />
                <TextBlock Text="값 (TOML 형식)" Margin="0,8,0,4" />
                <local:SecretValueEditor Value="{Binding Literal, UpdateSourceTrigger=PropertyChanged}" IsSecret="True" />
                <WrapPanel>
                    <Button Content="선택한 값 적용" Command="{Binding ApplyValueCommand}" Margin="0,4,8,4" />
                    <Button Content="선택한 키 삭제" Command="{Binding DeleteKeyCommand}" Margin="0,4,8,4"
                            ToolTip="독립된 주석·빈 줄은 보존합니다. 인라인 항목과 배열 원소 삭제는 아직 지원하지 않습니다." />
                </WrapPanel>
                <TextBlock Text="새 키 또는 테이블 경로 (예: features 또는 projects.'D:\project')" TextWrapping="Wrap" />
                <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" />
                <WrapPanel>
                    <Button Content="키 추가" Command="{Binding AddKeyCommand}" Margin="0,4,8,4" ToolTip="루트 또는 기존 명시적 테이블에 추가합니다. 인라인 테이블 추가는 미지원입니다." />
                    <Button Content="테이블 생성" Command="{Binding CreateTableCommand}" Margin="0,4,8,4" />
                    <Button Content="빈 테이블 정리" Command="{Binding CleanupCommand}" Margin="0,4,8,4" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FrontmatterFormViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,4,16,16" MaxWidth="900" HorizontalAlignment="Left" MinWidth="420">
                <TextBlock Style="{StaticResource FormLabel}" Text="name" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource FormLabel}" Text="description" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="60" MaxHeight="200" VerticalScrollBarVisibility="Auto" />

                <StackPanel Visibility="{Binding IsAgent, Converter={StaticResource FormBoolToVisible}}">
                    <TextBlock Style="{StaticResource FormLabel}" Text="tools (쉼표로 구분, 비우면 모든 도구)" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DropButton}" ToolTip="도구 추가" Tag="{Binding Tools}"
                                CommandParameter="{Binding AddToolCommand}" />
                        <TextBox Text="{Binding ToolList, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock Style="{StaticResource FormLabel}" Text="model (비우면 기본값)" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DropButton}" ToolTip="모델 선택" Tag="{Binding Models}"
                                CommandParameter="{Binding SetModelCommand}" />
                        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource FormLabel}" Text="본문 (Markdown)" />
                <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" MinHeight="240" VerticalScrollBarVisibility="Auto"
                         FontFamily="{DynamicResource DD.Font.Editor}" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Claude Code settings.json -->
    <DataTemplate DataType="{x:Type vm:SettingsFormViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,0,16,16">
                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding RoleSummary}" />
                <ItemsControl ItemsSource="{Binding RoleNotes}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource DD.Text.Secondary}" TextWrapping="Wrap" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding ScopeIssues}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3,0,0">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource DD.Glyph}" FontSize="12" Margin="0,1,6,0"
                                           Foreground="{DynamicResource DD.Brush.Warning}" Text="&#xE7BA;" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding Message}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource DD.Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="폼이 다루지 않는 키는 그대로 보존됩니다. 폼에서 고치면 JSON이 2칸 들여쓰기로 다시 정렬됩니다." />

                <TextBlock Style="{StaticResource FormSection}" Text="권한 (permissions)" />
                <TextBlock Style="{StaticResource DD.Text.Secondary}" TextWrapping="Wrap"
                           Text="[종류] [도구] [인수] — 인수를 비우면 도구 전체에 적용합니다. 줄을 선택하면 속성 창에 작성법이 표시됩니다." />
                <DockPanel Margin="0,4,0,4">
                    <Button DockPanel.Dock="Left" Style="{StaticResource RowButton}" Margin="0,0,6,0"
                            Command="{Binding RefreshMcpCommand}" ToolTip="MCP 설정 파일을 다시 읽습니다(서버는 실행하지 않음)">
                        <TextBlock Style="{StaticResource DD.Glyph}" FontSize="10" Text="&#xE72C;" />
                    </Button>
                    <Button Style="{StaticResource RowButton}" Command="{Binding ToggleMcpListCommand}" Padding="4,1"
                            ToolTip="찾은 MCP 서버 이름과 출처를 봅니다(서버를 실행하거나 연결하지 않음)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DD.Glyph}" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" Text="&#xE76C;" />
                            <TextBlock Text="{Binding McpStatus}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DockPanel>
                <Border Visibility="{Binding IsMcpListOpen, Converter={StaticResource FormBoolToVisible}}" Margin="0,0,0,6" Padding="8,4"
                        BorderThickness="1" BorderBrush="{DynamicResource DD.Brush.Popup.Border}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding McpServers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Margin="0,1" ToolTip="{Binding SourcePath}">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding Source, Mode=OneWay}" Foreground="{DynamicResource DD.Brush.Text.Secondary}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding McpProblems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource DD.Brush.Warning}" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource DD.Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="설정 파일에서 이름과 출처만 읽습니다. 서버를 실행하거나 연결하지 않으며, claude.ai 커넥터는 찾을 수 없습니다." />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Permissions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,3" Style="{StaticResource FormRowPanel}">
                                <ContentPresenter DockPanel.Dock="Right" ContentTemplate="{StaticResource RowTools}" Content="{Binding}" />
                                <!-- Warnings (also in the validation pane); saving is not blocked -->
                                <Grid DockPanel.Dock="Right" Width="18" Margin="4,0,0,0" Background="Transparent" ToolTip="{Binding IssueText}"
                                      ToolTipService.ShowDuration="60000">
                                    <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource DD.Brush.Warning}" Text="&#xE7BA;"
                                               Visibility="{Binding HasWarnings, Converter={StaticResource FormBoolToVisible}}" />
                                    <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource DD.Brush.Info}" Text="&#xE946;"
                                               Visibility="{Binding HasNotesOnly, Converter={StaticResource FormBoolToVisible}}" />
                                </Grid>
                                <DockPanel DockPanel.Dock="Left" Width="80" Margin="0,0,6,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource DropButton}" ToolTip="종류 (deny &gt; ask &gt; allow 순으로 우선)"
                                            Tag="{Binding DataContext.PermissionKinds, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding SetKindCommand}" />
                                    <TextBox Text="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <Grid>
                                    <!-- Parsed rule: tool + argument (shaped by the tool's argument kind) -->
                                    <DockPanel Visibility="{Binding IsParsed, Converter={StaticResource FormBoolToVisible}}">
                                        <DockPanel DockPanel.Dock="Left" Width="220" Margin="0,0,6,0">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource DropButton}" ToolTip="도구 선택"
                                                    Tag="{Binding DataContext.ToolChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding SetToolCommand}" />
                                            <Grid>
                                                <TextBox Text="{Binding Tool, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding ToolDescription}" />
                                                <TextBlock Style="{StaticResource FormPlaceholder}" Text="도구 (예: Bash)"
                                                           Visibility="{Binding Tool, Converter={StaticResource FormEmptyToVisible}}" />
                                            </Grid>
                                        </DockPanel>
                                        <!-- MCP: scope instead of an argument -->
                                        <DockPanel DockPanel.Dock="Left" Margin="0,0,6,0" Visibility="{Binding ShowMcpScope, Converter={StaticResource FormBoolToVisible}}">
                                            <Button DockPanel.Dock="Left" Style="{StaticResource SuggestionButton}" Padding="4,1" Margin="0,0,4,0"
                                                    Tag="{Binding McpScopeChoices}" CommandParameter="{Binding SetMcpScopeCommand}"
                                                    ToolTip="서버 전체 / 모든 도구(__*) / 특정 도구">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding McpScopeLabel}" VerticalAlignment="Center" />
                                                    <TextBlock Style="{StaticResource DD.Glyph}" FontSize="9" Margin="4,0,0,0" VerticalAlignment="Center" Text="&#xE70D;" />
                                                </StackPanel>
                                            </Button>
                                            <Grid Width="180">
                                                <TextBox Text="{Binding McpToolName, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource DD.Font.Editor}"
                                                         ToolTip="특정 도구의 이름 (입력하면 특정 도구 범위로 바뀜)" />
                                                <TextBlock Style="{StaticResource FormPlaceholder}" Text="도구 이름"
                                                           Visibility="{Binding McpToolName, Converter={StaticResource FormEmptyToVisible}}" />
                                            </Grid>
                                        </DockPanel>
                                        <Grid Visibility="{Binding ShowArgumentBox, Converter={StaticResource FormBoolToVisible}}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,4,0" Text="{Binding Prefix}"
                                                           FontFamily="{DynamicResource DD.Font.Editor}" Foreground="{DynamicResource DD.Brush.Text.Secondary}"
                                                           Visibility="{Binding UsesPrefix, Converter={StaticResource FormBoolToVisible}}" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource DropButton}" ToolTip="에이전트 선택"
                                                        Visibility="{Binding HasArgumentChoices, Converter={StaticResource FormBoolToVisible}}"
                                                        Tag="{Binding DataContext.AgentChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding SetArgumentCommand}" />
                                                <Grid>
                                                    <TextBox Text="{Binding ArgumentValue, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding ToolDescription}"
                                                             IsEnabled="{Binding IsArgumentEnabled}" FontFamily="{DynamicResource DD.Font.Editor}" />
                                                    <TextBlock Style="{StaticResource FormPlaceholder}" Text="{Binding ArgumentPlaceholder}"
                                                               Visibility="{Binding Argument, Converter={StaticResource FormEmptyToVisible}}" />
                                                </Grid>
                                            </DockPanel>
                                        </Grid>
                                    </DockPanel>
                                    <!-- Rule the form cannot split: one text, saved as it is -->
                                    <TextBox Visibility="{Binding IsParsed, Converter={StaticResource FormFalseToVisible}}"
                                             Text="{Binding Tool, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource DD.Font.Editor}"
                                             ToolTip="형식을 해석할 수 없는 규칙입니다. 고치지 않으면 원문 그대로 저장합니다." />
                                </Grid>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource AddButton}" Content="+ allow" Command="{Binding AddPermissionCommand}" CommandParameter="allow" />
                    <Button Style="{StaticResource AddButton}" Content="+ ask" Command="{Binding AddPermissionCommand}" CommandParameter="ask" />
                    <Button Style="{StaticResource AddButton}" Content="+ deny" Command="{Binding AddPermissionCommand}" CommandParameter="deny" />
                </StackPanel>

                <TextBlock Style="{StaticResource FormSection}" Text="훅 (hooks)" />
                <local:HookTable DataContext="{Binding HookTable}" />


                <TextBlock Style="{StaticResource FormSection}" Text="환경 변수 (env)" />
                <ItemsControl ItemsSource="{Binding Env}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,3" Style="{StaticResource FormRowPanel}">
                                <ContentPresenter DockPanel.Dock="Right" ContentTemplate="{StaticResource RowTools}" Content="{Binding}" />
                                <TextBox DockPanel.Dock="Left" Width="220" Margin="0,0,6,0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" />
                                <local:SecretValueEditor Value="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsSecret="{Binding IsSecret}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource AddButton}" Content="+ 변수 추가" Command="{Binding AddEnvCommand}" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
