<UserControl x:Class="DotDeck.App.Views.Explorer.ExplorerListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DotDeck.App.Converters"
             xmlns:ex="clr-namespace:DotDeck.App.ViewModels.Explorer"
             xmlns:core="clr-namespace:DotDeck.Core.Explorer;assembly=DotDeck.Core"
             xmlns:vis="clr-namespace:DotDeck.Core.Explorer.Visibility;assembly=DotDeck.Core"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             Background="{DynamicResource DD.Brush.Panel.Background}">
    <UserControl.Resources>
        <conv:DepthToIndentConverter x:Key="Indent" />
        <conv:FileKindToGlyphConverter x:Key="FileGlyph" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <BooleanToVisibilityConverter x:Key="TrueToVisible" />
        <conv:FalseToVisibleConverter x:Key="FalseToVisible" />
        <conv:InvertBooleanConverter x:Key="Invert" />

        <Style x:Key="RowGlyph" TargetType="TextBlock" BasedOn="{StaticResource DD.Glyph}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="18" />
        </Style>

        <Style x:Key="Chevron" TargetType="TextBlock" BasedOn="{StaticResource DD.Glyph}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource DD.Brush.Text.Secondary}" />
        </Style>

        <!-- In-place name editor (rename, new item). Enter commits, Esc cancels, leaving the box commits. -->
        <Style x:Key="InlineEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Padding" Value="1,0" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <EventSetter Event="KeyDown" Handler="OnEditorKeyDown" />
            <EventSetter Event="LostKeyboardFocus" Handler="OnEditorLostFocus" />
        </Style>

        <!-- Small flat button in the project header toolbar -->
        <Style x:Key="HeaderButton" TargetType="ButtonBase">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource DD.Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DD.Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="Tag">
                                <Trigger.Value>
                                    <sys:Boolean>True</sys:Boolean>
                                </Trigger.Value>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DD.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DD.Brush.Text.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderTextButton" TargetType="ButtonBase" BasedOn="{StaticResource HeaderButton}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <!-- Edit-mode check box (a button: the state comes from the rules, a click only asks to toggle). -->
        <Style x:Key="CheckButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="ToolTip" Value="체크: 보임 / 해제: 숨김 / ■: 일부만 보임" />
        </Style>

        <!-- ===== Project header ===== -->
        <DataTemplate DataType="{x:Type ex:ProjectHeaderRowViewModel}">
            <Border x:Name="DropBd" BorderThickness="1" BorderBrush="Transparent">
            <Grid x:Name="Root" Background="Transparent" ToolTip="{Binding RootPath}">
                <Grid.ContextMenu>
                    <ContextMenu Opened="OnContextMenuOpened">
                        <MenuItem Header="새 파일(_W)" Command="{Binding Explorer.List.NewFileCommand}" />
                        <MenuItem Header="새 폴더(_F)" Command="{Binding Explorer.List.NewFolderCommand}" />
                        <MenuItem Header="붙여넣기(_P)" Command="{Binding Explorer.List.PasteCommand}" InputGestureText="Ctrl+V" />
                        <Separator />
                        <MenuItem Header="프로젝트 편집(_E)..." Command="{Binding Explorer.EditProjectCommand}" />
                        <MenuItem Header="보이는 항목 편집(_I)" Command="{Binding Explorer.ToggleVisibilityEditCommand}"
                                  IsCheckable="True" IsChecked="{Binding Explorer.IsEditingVisibility, Mode=OneWay}"
                                  Visibility="{Binding Explorer.SupportsVisibility, Converter={StaticResource TrueToVisible}}" />
                        <MenuItem Header="보기(_B)" Visibility="{Binding Explorer.SupportsVisibility, Converter={StaticResource TrueToVisible}}">
                            <MenuItem Header="트리" Command="{Binding Explorer.SetViewModeCommand}" CommandParameter="Tree"
                                      IsCheckable="True" IsChecked="{Binding Explorer.IsTreeMode, Mode=OneWay}" />
                            <MenuItem Header="압축 트리" Command="{Binding Explorer.SetViewModeCommand}" CommandParameter="Compact"
                                      IsCheckable="True" IsChecked="{Binding Explorer.IsCompactMode, Mode=OneWay}" />
                            <MenuItem Header="평면" Command="{Binding Explorer.SetViewModeCommand}" CommandParameter="Flat"
                                      IsCheckable="True" IsChecked="{Binding Explorer.IsFlatMode, Mode=OneWay}" />
                            <Separator />
                            <MenuItem Header="평면: 이름순" Command="{Binding Explorer.SetFlatSortCommand}" CommandParameter="Name"
                                      IsCheckable="True" IsChecked="{Binding Explorer.IsCustomFlatSort, Mode=OneWay, Converter={StaticResource Invert}}" />
                            <MenuItem Header="평면: 사용자 순서(끌어서 정렬)" Command="{Binding Explorer.SetFlatSortCommand}" CommandParameter="Custom"
                                      IsCheckable="True" IsChecked="{Binding Explorer.IsCustomFlatSort, Mode=OneWay}" />
                        </MenuItem>
                        <MenuItem Header="숨기기(_H)" Command="{Binding Explorer.HideProjectCommand}" />
                        <Separator />
                        <MenuItem Header="위로 이동(_U)" Command="{Binding Explorer.MoveUpCommand}" />
                        <MenuItem Header="아래로 이동(_D)" Command="{Binding Explorer.MoveDownCommand}" />
                        <MenuItem Header="별도 패널로 떼어내기(_T)" Command="{Binding Explorer.DetachCommand}"
                                  Visibility="{Binding Explorer.IsDetached, Converter={StaticResource FalseToVisible}}" />
                        <MenuItem Header="프로젝트 영역에 다시 붙이기(_A)" Command="{Binding Explorer.ReattachCommand}"
                                  Visibility="{Binding Explorer.IsDetached, Converter={StaticResource TrueToVisible}}" />
                        <Separator />
                        <MenuItem Header="루트 경로 복사(_C)" Command="{Binding Explorer.CopyRootPathCommand}" />
                        <MenuItem Header="탐색기에서 열기(_X)" Command="{Binding Explorer.RevealRootCommand}" />
                        <MenuItem Header="VS Code로 열기(_V)" Command="{Binding Explorer.List.OpenInVsCodeCommand}" />
                        <MenuItem Header="여기서 터미널 열기(_L)" Command="{Binding Explorer.List.OpenTerminalCommand}" />
                        <MenuItem Header="새로고침(_R)" Command="{Binding Explorer.LoadCommand}" />
                        <Separator Visibility="{Binding Explorer.IsBuiltin, Converter={StaticResource FalseToVisible}}" />
                        <MenuItem Header="목록에서 제거(_M)..." Command="{Binding Explorer.RemoveProjectCommand}"
                                  Visibility="{Binding Explorer.IsBuiltin, Converter={StaticResource FalseToVisible}}" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Project root: a filled accent badge with a solid caret, distinct from the plain folder chevrons. -->
                <Border Width="16" Height="16" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,1,0"
                        Background="{DynamicResource DD.Brush.Accent}" ToolTip="프로젝트 루트">
                    <TextBlock x:Name="HeaderChevron" Style="{StaticResource DD.Glyph}" FontSize="8"
                               Foreground="{DynamicResource DD.Brush.Text.OnAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xEDDC;" />
                </Border>
                <Border Grid.Column="1" Width="3" Height="14" Margin="2,0,6,0" VerticalAlignment="Center"
                        Background="{Binding Color, TargetNullValue=Transparent}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="RootCheck" Style="{StaticResource CheckButton}"
                            Command="{Binding Explorer.ToggleCheckCommand}" CommandParameter="{Binding}"
                            Visibility="{Binding CheckState, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock x:Name="RootCheckGlyph" Style="{StaticResource DD.Glyph}" FontSize="13" Text="&#xE739;" />
                    </Button>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="4" Content="편집 끝내기" Margin="4,0" Padding="6,0"
                        Command="{Binding Explorer.ToggleVisibilityEditCommand}" ToolTip="체크한 항목을 저장하고 보통 보기로 돌아갑니다"
                        Visibility="{Binding Explorer.IsEditingVisibility, Converter={StaticResource TrueToVisible}}" />
                <StackPanel x:Name="Toolbar" Grid.Column="3" Orientation="Horizontal" Visibility="Hidden">
                    <!-- Plain Buttons: a ToggleButton would overwrite its IsChecked binding on click. Tag = "on". -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,4,0"
                                Visibility="{Binding Explorer.SupportsVisibility, Converter={StaticResource TrueToVisible}}">
                        <Button Style="{StaticResource HeaderTextButton}" Content="트리" Tag="{Binding Explorer.IsTreeMode}"
                                Command="{Binding Explorer.SetViewModeCommand}" CommandParameter="Tree" ToolTip="트리 보기" />
                        <Button Style="{StaticResource HeaderTextButton}" Content="압축" Tag="{Binding Explorer.IsCompactMode}"
                                Command="{Binding Explorer.SetViewModeCommand}" CommandParameter="Compact"
                                ToolTip="압축 트리: 하위 폴더가 하나뿐인 폴더를 한 줄로 합칩니다" />
                        <Button Style="{StaticResource HeaderTextButton}" Content="평면" Tag="{Binding Explorer.IsFlatMode}"
                                Command="{Binding Explorer.SetViewModeCommand}" CommandParameter="Flat"
                                ToolTip="평면: 보이는 파일만 한 목록으로" />
                        <Button Style="{StaticResource HeaderButton}" Tag="{Binding Explorer.IsEditingVisibility}"
                                Command="{Binding Explorer.ToggleVisibilityEditCommand}" ToolTip="보이는 항목 편집 (✎)">
                            <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE70F;" />
                        </Button>
                    </StackPanel>
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding Explorer.CollapseAllCommand}" ToolTip="모두 접기">
                        <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE70E;" />
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding Explorer.LoadCommand}" ToolTip="새로고침">
                        <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE72C;" />
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding Explorer.CopyRootPathCommand}" ToolTip="루트 경로 복사">
                        <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE8C8;" />
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding Explorer.RevealRootCommand}" ToolTip="Windows 탐색기에서 열기">
                        <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE838;" />
                    </Button>
                </StackPanel>
            </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="DropBd" Property="BorderBrush" Value="{DynamicResource DD.Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                    <Setter TargetName="HeaderChevron" Property="Text" Value="&#xEDDA;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckState}" Value="{x:Static vis:CheckState.Checked}">
                    <Setter TargetName="RootCheckGlyph" Property="Text" Value="&#xE73A;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckState}" Value="{x:Static vis:CheckState.Partial}">
                    <Setter TargetName="RootCheckGlyph" Property="Text" Value="&#xE73C;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Explorer.IsEditingVisibility}" Value="True">
                    <Setter TargetName="Toolbar" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RootPath}" Value="{x:Null}">
                    <!-- Virtual project: no folder tools -->
                    <Setter TargetName="Toolbar" Property="IsEnabled" Value="False" />
                </DataTrigger>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Toolbar" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Toolbar" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Node ===== -->
        <DataTemplate DataType="{x:Type ex:NodeRowViewModel}">
            <Border x:Name="DropBd" BorderThickness="1" BorderBrush="Transparent">
            <StackPanel x:Name="Root" Orientation="Horizontal" Margin="{Binding Depth, Converter={StaticResource Indent}}"
                        Background="Transparent" ToolTip="{Binding ToolTipText}" IsEnabled="{Binding IsEnabled}">
                <TextBlock x:Name="NodeChevron" Style="{StaticResource Chevron}" Text="" />
                <Button Style="{StaticResource CheckButton}"
                        Command="{Binding Explorer.ToggleCheckCommand}" CommandParameter="{Binding}"
                        Visibility="{Binding CheckState, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock x:Name="CheckGlyph" Style="{StaticResource DD.Glyph}" FontSize="13" Text="&#xE739;" />
                </Button>
                <TextBlock x:Name="Pin" Style="{StaticResource RowGlyph}" FontSize="11" Text="&#xE718;" Width="14"
                           Foreground="{DynamicResource DD.Brush.Text.Secondary}" ToolTip="최상위에 고정됨" Visibility="Collapsed" />
                <TextBlock x:Name="Icon" Style="{StaticResource RowGlyph}"
                           Text="{Binding Node.FileKind, Converter={StaticResource FileGlyph}}"
                           Foreground="{DynamicResource DD.Brush.FileKind.Text}" />
                <TextBlock x:Name="Label" Text="{Binding Name}" Margin="4,0,0,0" VerticalAlignment="Center" />
                <!-- Compact tree: each merged folder is clickable (it becomes the target of commands). -->
                <ItemsControl x:Name="Chain" ItemsSource="{Binding Segments}" Margin="4,0,0,0" VerticalAlignment="Center"
                              Focusable="False" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Slash" Text="/" Margin="1,0" Foreground="{DynamicResource DD.Brush.Text.Secondary}" />
                                <TextBlock>
                                    <Hyperlink Command="{Binding DataContext.SelectSegmentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                               CommandParameter="{Binding}" Foreground="{DynamicResource DD.Brush.Text}"
                                               TextDecorations="{x:Null}" ToolTip="이 폴더 선택">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Index}" Value="0">
                                    <Setter TargetName="Slash" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Flat view: the file's folder, dimmed. -->
                <TextBlock Text="{Binding FlatDirectoryText}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource DD.Text.Secondary}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding FlatDirectoryText, Converter={StaticResource NullToCollapsed}}" />
                <TextBox x:Name="Editor" Style="{StaticResource InlineEditor}" Visibility="Collapsed"
                         Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock x:Name="Lock" Style="{StaticResource RowGlyph}" FontSize="11" Text="&#xE72E;" Margin="4,0,0,0"
                           Foreground="{DynamicResource DD.Brush.FileKind.Secret}" Visibility="Collapsed" />
                <TextBlock x:Name="Warn" Style="{StaticResource RowGlyph}" FontSize="11" Text="&#xE7BA;" Margin="4,0,0,0"
                           Foreground="{DynamicResource DD.Brush.Warning}" />
            </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasSegments}" Value="True">
                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Chain" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Chain" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Editor" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="DropBd" Property="BorderBrush" Value="{DynamicResource DD.Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.IsPinned}" Value="True">
                    <Setter TargetName="Pin" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckState}" Value="{x:Static vis:CheckState.Checked}">
                    <Setter TargetName="CheckGlyph" Property="Text" Value="&#xE73A;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckState}" Value="{x:Static vis:CheckState.Partial}">
                    <Setter TargetName="CheckGlyph" Property="Text" Value="&#xE73C;" />
                </DataTrigger>
                <!-- Edit mode: what stays hidden afterwards is dimmed. -->
                <DataTrigger Binding="{Binding CheckState}" Value="{x:Static vis:CheckState.Unchecked}">
                    <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                </DataTrigger>
                <!-- Folders -->
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="NodeChevron" Property="Text" Value="&#xE76C;" />
                    <Setter TargetName="Icon" Property="Text" Value="&#xE8B7;" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Folder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="NodeChevron" Property="Text" Value="&#xE70D;" />
                    <Setter TargetName="Icon" Property="Text" Value="&#xE838;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKnownEmpty}" Value="True">
                    <Setter TargetName="NodeChevron" Property="Text" Value="" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter TargetName="NodeChevron" Property="Text" Value="&#xE895;" />
                </DataTrigger>
                <!-- File kinds -->
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Markdown}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Markdown}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Json}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Json}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Toml}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Toml}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Yaml}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Yaml}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.PowerShell}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Script}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Script}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Script}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Python}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Script}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.CSharp}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.CSharp}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Xaml}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Xml}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Xml}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Xml}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.MsBuild}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.CSharp}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Solution}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.CSharp}" />
                </DataTrigger>
                <!-- Secret / problem / state -->
                <DataTrigger Binding="{Binding Node.IsSecret}" Value="True">
                    <Setter TargetName="Lock" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Secret}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                    <Setter TargetName="Warn" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.IsHidden}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.65" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.Kind}" Value="{x:Static core:NodeKind.Virtual}">
                    <Setter TargetName="Icon" Property="Text" Value="&#xE7F4;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource DD.Brush.Text.Disabled}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.Text.Disabled}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== New item placeholder ===== -->
        <DataTemplate DataType="{x:Type ex:NewItemRowViewModel}">
            <StackPanel Orientation="Horizontal" Margin="{Binding Depth, Converter={StaticResource Indent}}">
                <TextBlock Style="{StaticResource Chevron}" Text="" />
                <TextBlock x:Name="Icon" Style="{StaticResource RowGlyph}" Text="&#xE8A5;"
                           Foreground="{DynamicResource DD.Brush.FileKind.Text}" />
                <TextBox x:Name="Editor" Style="{StaticResource InlineEditor}" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="이름 입력 후 Enter (Esc: 취소)" />
            </StackPanel>
            <DataTemplate.Triggers>
                <!-- Hidden while the create runs; shown (and refocused) again if it failed. -->
                <DataTrigger Binding="{Binding IsEditing}" Value="False">
                    <Setter TargetName="Editor" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="Icon" Property="Text" Value="&#xE8B7;" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Folder}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Message ===== -->
        <DataTemplate DataType="{x:Type ex:MessageRowViewModel}">
            <StackPanel Orientation="Horizontal" Margin="22,0,0,0">
                <TextBlock x:Name="Text" Text="{Binding Text}" Style="{StaticResource DD.Text.Secondary}" FontStyle="Italic"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding ActionText, Converter={StaticResource NullToCollapsed}}">
                    <Hyperlink Command="{Binding Action}" Foreground="{DynamicResource DD.Brush.Info}">
                        <Run Text="{Binding ActionText, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource DD.Brush.Error}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Breadcrumb: full path of the selection (SPEC 2.3) -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DD.Brush.Border}"
                Background="{DynamicResource DD.Brush.Panel.Background}" MinHeight="24" ToolTip="{Binding SelectedPath}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource HeaderButton}" Command="{Binding CopySelectedPathCommand}"
                        ToolTip="선택 항목 경로 복사" Margin="2,0,4,0">
                    <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE8C8;" />
                </Button>
                <ItemsControl ItemsSource="{Binding Breadcrumb}" Margin="6,0,0,0" VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Separator" Style="{StaticResource DD.Glyph}" FontSize="8" Margin="4,0"
                                           Foreground="{DynamicResource DD.Brush.Text.Secondary}" Text="&#xE76C;" />
                                <TextBlock VerticalAlignment="Center">
                                    <Hyperlink Command="{Binding DataContext.SelectBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" Foreground="{DynamicResource DD.Brush.Text}"
                                               TextDecorations="{x:Null}">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                    <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <ListBox x:Name="Tree"
                 ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedRow}"
                 SelectionMode="Extended"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Item"
                 AllowDrop="True"
                 PreviewKeyDown="OnTreePreviewKeyDown"
                 SelectionChanged="OnTreeSelectionChanged"
                 PreviewMouseMove="OnTreePreviewMouseMove"
                 PreviewMouseLeftButtonUp="OnTreePreviewMouseUp"
                 DragOver="OnTreeDragOver"
                 DragLeave="OnTreeDragLeave"
                 Drop="OnTreeDrop">
            <ListBox.ContextMenu>
                <ContextMenu Opened="OnContextMenuOpened">
                    <MenuItem Header="열기(_O)" Command="{Binding OpenSelectedCommand}" InputGestureText="Enter" />
                    <MenuItem Header="다음 형식으로 열기(_K)" ItemsSource="{Binding EditorChoices}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding Label}" />
                                <Setter Property="Command" Value="{Binding Command}" />
                                <Setter Property="CommandParameter" Value="{Binding Name}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <MenuItem Header="사용자 지정 파일 등록(경로 입력)(_G)..." Command="{Binding RegisterOtherFileCommand}"
                              Visibility="{Binding IsOtherFilesTarget, Converter={StaticResource TrueToVisible}}" />
                    <MenuItem Header="사용자 지정 파일 추가(찾아보기)(_I)..." Command="{Binding BrowseOtherFileCommand}"
                              Visibility="{Binding IsOtherFilesTarget, Converter={StaticResource TrueToVisible}}" />
                    <MenuItem Header="사용자 지정 파일 목록에서 빼기(_U)" Command="{Binding UnregisterOtherFileCommand}"
                              Visibility="{Binding IsOtherFileItem, Converter={StaticResource TrueToVisible}}" />
                    <Separator />
                    <MenuItem Header="새 파일(_W)" Command="{Binding NewFileCommand}" />
                    <MenuItem Header="새 폴더(_F)" Command="{Binding NewFolderCommand}" />
                    <Separator />
                    <MenuItem Header="잘라내기(_T)" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
                    <MenuItem Header="복사(_C)" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
                    <MenuItem Header="붙여넣기(_P)" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
                    <MenuItem Header="복제(_D)" Command="{Binding DuplicateCommand}" InputGestureText="Ctrl+D" />
                    <MenuItem Header="이름 바꾸기(_M)" Command="{Binding RenameCommand}" InputGestureText="F2" />
                    <MenuItem Header="삭제(_E)" Command="{Binding DeleteCommand}" InputGestureText="Del" />
                    <Separator />
                    <MenuItem Header="{Binding UndoText}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                    <MenuItem Header="{Binding RedoText}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                    <Separator />
                    <MenuItem Header="전체 경로 복사(_A)" Command="{Binding CopyFullPathsCommand}" InputGestureText="Ctrl+Shift+C" />
                    <MenuItem Header="상대 경로 복사(_R)" Command="{Binding CopyRelativePathsCommand}" />
                    <MenuItem Header="탐색기에서 열기(_X)" Command="{Binding RevealSelectedCommand}" />
                    <MenuItem Header="VS Code로 열기(_V)" Command="{Binding OpenInVsCodeCommand}" />
                    <MenuItem Header="여기서 터미널 열기(_L)" Command="{Binding OpenTerminalCommand}" />
                    <Separator Visibility="{Binding IsVisibilityTarget, Converter={StaticResource TrueToVisible}}" />
                    <MenuItem Header="{Binding PinText}" Command="{Binding TogglePinCommand}"
                              Visibility="{Binding IsVisibilityTarget, Converter={StaticResource TrueToVisible}}" />
                    <MenuItem Header="트리에서 위치 보기(_Y)" Command="{Binding RevealInTreeCommand}"
                              Visibility="{Binding IsVisibilityTarget, Converter={StaticResource TrueToVisible}}" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="Padding" Value="0,0,4,0" />
                    <Setter Property="MinHeight" Value="{DynamicResource DD.Size.TreeRowHeight}" />
                    <Setter Property="Height" Value="{DynamicResource DD.Size.TreeRowHeight}" />
                    <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnRowPreviewMouseDown" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</UserControl>
