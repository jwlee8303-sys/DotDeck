<UserControl x:Class="DotDeck.App.Views.Explorer.ProjectsPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DotDeck.App.Converters"
             xmlns:ex="clr-namespace:DotDeck.App.ViewModels.Explorer"
             xmlns:core="clr-namespace:DotDeck.Core.Explorer;assembly=DotDeck.Core"
             Background="{DynamicResource DD.Brush.Panel.Background}">
    <UserControl.Resources>
        <conv:DepthToIndentConverter x:Key="Indent" />
        <conv:FileKindToGlyphConverter x:Key="FileGlyph" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />

        <Style x:Key="RowGlyph" TargetType="TextBlock" BasedOn="{StaticResource DD.Glyph}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="18" />
        </Style>

        <Style x:Key="Chevron" TargetType="TextBlock" BasedOn="{StaticResource DD.Glyph}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource DD.Brush.Text.Secondary}" />
        </Style>

        <!-- Small flat button in the project header toolbar -->
        <Style x:Key="HeaderButton" TargetType="ButtonBase">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource DD.Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DD.Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DD.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DD.Brush.Text.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Project header ===== -->
        <DataTemplate DataType="{x:Type ex:ProjectHeaderRowViewModel}">
            <Grid x:Name="Root" Background="Transparent" ToolTip="{Binding RootPath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderChevron" Style="{StaticResource Chevron}" Text="&#xE70D;" />
                <Border Grid.Column="1" Width="3" Height="14" Margin="2,0,6,0" VerticalAlignment="Center"
                        Background="{Binding Color, TargetNullValue=Transparent}" />
                <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel x:Name="Toolbar" Grid.Column="3" Orientation="Horizontal" Visibility="Hidden">
                    <ToggleButton Style="{StaticResource HeaderButton}" IsChecked="{Binding IsConfigDocsFilter, Mode=OneWay}"
                                  Command="{Binding Explorer.ToggleFilterCommand}" ToolTip="설정·문서 파일만 표시">
                        <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE71C;" />
                    </ToggleButton>
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding Explorer.CollapseAllCommand}" ToolTip="모두 접기">
                        <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE70E;" />
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding Explorer.LoadCommand}" ToolTip="새로고침">
                        <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE72C;" />
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding Explorer.CopyRootPathCommand}" ToolTip="루트 경로 복사">
                        <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE8C8;" />
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Command="{Binding Explorer.RevealRootCommand}" ToolTip="Windows 탐색기에서 열기">
                        <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE838;" />
                    </Button>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                    <Setter TargetName="HeaderChevron" Property="Text" Value="&#xE76C;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RootPath}" Value="{x:Null}">
                    <!-- Virtual project: no folder tools -->
                    <Setter TargetName="Toolbar" Property="IsEnabled" Value="False" />
                </DataTrigger>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Toolbar" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Toolbar" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Node ===== -->
        <DataTemplate DataType="{x:Type ex:NodeRowViewModel}">
            <StackPanel x:Name="Root" Orientation="Horizontal" Margin="{Binding Depth, Converter={StaticResource Indent}}"
                        Background="Transparent" ToolTip="{Binding ToolTipText}" IsEnabled="{Binding IsEnabled}">
                <TextBlock x:Name="NodeChevron" Style="{StaticResource Chevron}" Text="" />
                <TextBlock x:Name="Icon" Style="{StaticResource RowGlyph}"
                           Text="{Binding Node.FileKind, Converter={StaticResource FileGlyph}}"
                           Foreground="{DynamicResource DD.Brush.FileKind.Text}" />
                <TextBlock x:Name="Label" Text="{Binding Name}" Margin="4,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="Lock" Style="{StaticResource RowGlyph}" FontSize="11" Text="&#xE72E;" Margin="4,0,0,0"
                           Foreground="{DynamicResource DD.Brush.FileKind.Secret}" Visibility="Collapsed" />
                <TextBlock x:Name="Warn" Style="{StaticResource RowGlyph}" FontSize="11" Text="&#xE7BA;" Margin="4,0,0,0"
                           Foreground="{DynamicResource DD.Brush.Warning}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <!-- Folders -->
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="NodeChevron" Property="Text" Value="&#xE76C;" />
                    <Setter TargetName="Icon" Property="Text" Value="&#xE8B7;" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Folder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="NodeChevron" Property="Text" Value="&#xE70D;" />
                    <Setter TargetName="Icon" Property="Text" Value="&#xE838;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKnownEmpty}" Value="True">
                    <Setter TargetName="NodeChevron" Property="Text" Value="" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter TargetName="NodeChevron" Property="Text" Value="&#xE895;" />
                </DataTrigger>
                <!-- File kinds -->
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Markdown}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Markdown}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Json}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Json}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Toml}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Toml}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Yaml}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Yaml}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.PowerShell}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Script}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Script}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Script}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Python}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Script}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.CSharp}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.CSharp}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Xaml}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Xml}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Xml}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Xml}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.MsBuild}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.CSharp}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.FileKind}" Value="{x:Static core:FileKind.Solution}">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.CSharp}" />
                </DataTrigger>
                <!-- Secret / problem / state -->
                <DataTrigger Binding="{Binding Node.IsSecret}" Value="True">
                    <Setter TargetName="Lock" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.FileKind.Secret}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                    <Setter TargetName="Warn" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.IsHidden}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.65" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.Kind}" Value="{x:Static core:NodeKind.Virtual}">
                    <Setter TargetName="Icon" Property="Text" Value="&#xE7F4;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource DD.Brush.Text.Disabled}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DD.Brush.Text.Disabled}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Message ===== -->
        <DataTemplate DataType="{x:Type ex:MessageRowViewModel}">
            <StackPanel Orientation="Horizontal" Margin="22,0,0,0">
                <TextBlock x:Name="Text" Text="{Binding Text}" Style="{StaticResource DD.Text.Secondary}" FontStyle="Italic"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding ActionText, Converter={StaticResource NullToCollapsed}}">
                    <Hyperlink Command="{Binding Action}" Foreground="{DynamicResource DD.Brush.Info}">
                        <Run Text="{Binding ActionText, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource DD.Brush.Error}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Breadcrumb: full path of the selection (SPEC 2.3) -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DD.Brush.Border}"
                Background="{DynamicResource DD.Brush.Panel.Background}" MinHeight="24" ToolTip="{Binding SelectedPath}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource HeaderButton}" Command="{Binding CopySelectedPathCommand}"
                        ToolTip="선택 항목 경로 복사" Margin="2,0,4,0">
                    <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE8C8;" />
                </Button>
                <ItemsControl ItemsSource="{Binding Breadcrumb}" Margin="6,0,0,0" VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Separator" Style="{StaticResource DD.Glyph}" FontSize="8" Margin="4,0"
                                           Foreground="{DynamicResource DD.Brush.Text.Secondary}" Text="&#xE76C;" />
                                <TextBlock VerticalAlignment="Center">
                                    <Hyperlink Command="{Binding DataContext.SelectBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" Foreground="{DynamicResource DD.Brush.Text}"
                                               TextDecorations="{x:Null}">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                    <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <ListBox x:Name="Tree"
                 ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedRow}"
                 SelectionMode="Extended"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Item"
                 PreviewKeyDown="OnTreePreviewKeyDown">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="Padding" Value="0,0,4,0" />
                    <Setter Property="MinHeight" Value="{DynamicResource DD.Size.TreeRowHeight}" />
                    <Setter Property="Height" Value="{DynamicResource DD.Size.TreeRowHeight}" />
                    <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnRowPreviewMouseDown" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</UserControl>
