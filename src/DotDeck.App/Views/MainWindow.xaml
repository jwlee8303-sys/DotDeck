<Window x:Class="DotDeck.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:adv="clr-namespace:AvalonDock.Themes.VS;assembly=AvalonDock.Themes.VS"
        xmlns:vm="clr-namespace:DotDeck.App.ViewModels"
        xmlns:docking="clr-namespace:DotDeck.App.Docking"
        xmlns:conv="clr-namespace:DotDeck.App.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="{Binding Title}"
        Width="1400" Height="860" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PaneTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToHiddenConverter x:Key="BoolToHidden" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewScratchDocumentCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="새 파일(_N)" InputGestureText="Ctrl+N" Command="{Binding NewScratchDocumentCommand}" />
                <MenuItem Header="열기(_O)..." InputGestureText="Ctrl+O" IsEnabled="False" />
                <Separator />
                <MenuItem Header="저장(_S)" InputGestureText="Ctrl+S" IsEnabled="False" />
                <MenuItem Header="모두 저장(_L)" InputGestureText="Ctrl+Shift+S" IsEnabled="False" />
                <Separator />
                <MenuItem Header="끝내기(_X)" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="편집(_E)">
                <MenuItem Header="실행 취소(_U)" InputGestureText="Ctrl+Z" IsEnabled="False" />
                <MenuItem Header="다시 실행(_R)" InputGestureText="Ctrl+Y" IsEnabled="False" />
                <Separator />
                <MenuItem Header="찾기(_F)" InputGestureText="Ctrl+F" IsEnabled="False" />
                <MenuItem Header="바꾸기(_H)" InputGestureText="Ctrl+H" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="보기(_V)">
                <MenuItem Header="시작 페이지" Command="{Binding ShowWelcomeCommand}" />
                <Separator />
                <MenuItem Header="프로젝트" IsCheckable="True" IsChecked="{Binding Projects.IsVisible, Mode=OneWay}"
                          Command="{Binding ToggleToolCommand}" CommandParameter="{Binding Projects}" />
                <MenuItem Header="속성" IsCheckable="True" IsChecked="{Binding Properties.IsVisible, Mode=OneWay}"
                          Command="{Binding ToggleToolCommand}" CommandParameter="{Binding Properties}" />
                <MenuItem Header="출력" IsCheckable="True" IsChecked="{Binding Output.IsVisible, Mode=OneWay}"
                          Command="{Binding ToggleToolCommand}" CommandParameter="{Binding Output}" />
                <MenuItem Header="검증 결과" IsCheckable="True" IsChecked="{Binding Validation.IsVisible, Mode=OneWay}"
                          Command="{Binding ToggleToolCommand}" CommandParameter="{Binding Validation}" />
                <MenuItem Header="검색 결과" IsCheckable="True" IsChecked="{Binding SearchResults.IsVisible, Mode=OneWay}"
                          Command="{Binding ToggleToolCommand}" CommandParameter="{Binding SearchResults}" />
                <MenuItem Header="훅 테스트" IsCheckable="True" IsChecked="{Binding HookTest.IsVisible, Mode=OneWay}"
                          Command="{Binding ToggleToolCommand}" CommandParameter="{Binding HookTest}" />
            </MenuItem>
            <MenuItem Header="프로젝트(_P)">
                <MenuItem Header="프로젝트 추가(_A)..." IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="도구(_T)">
                <MenuItem Header="설정(_O)..." IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="창(_W)">
                <MenuItem Header="레이아웃 초기화(_R)" Click="OnResetLayoutClick" />
            </MenuItem>
            <MenuItem Header="도움말(_H)">
                <MenuItem Header="DotDeck 정보(_A)" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar ToolBarTray.IsLocked="True">
                <Button ToolTip="새 파일 (Ctrl+N)" Command="{Binding NewScratchDocumentCommand}">
                    <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xE8A5;" />
                </Button>
                <Button ToolTip="열기 (Ctrl+O)" IsEnabled="False">
                    <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xE8E5;" />
                </Button>
                <Button ToolTip="저장 (Ctrl+S)" IsEnabled="False">
                    <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xE74E;" />
                </Button>
                <Button ToolTip="모두 저장 (Ctrl+Shift+S)" IsEnabled="False">
                    <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xEA35;" />
                </Button>
                <Separator />
                <Button ToolTip="실행 취소 (Ctrl+Z)" IsEnabled="False">
                    <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xE7A7;" />
                </Button>
                <Button ToolTip="다시 실행 (Ctrl+Y)" IsEnabled="False">
                    <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xE7A6;" />
                </Button>
            </ToolBar>
            <ToolBar ToolBarTray.IsLocked="True">
                <TextBox Width="260" IsEnabled="False" ToolTip="전역 검색 (Ctrl+Shift+F) — Phase 4" />
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right" Content="{Binding PrivilegeStatusText}" />
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem DockPanel.Dock="Right" Content="{Binding HomeStatusText}" />
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem Content="{Binding StatusMessage}" />
        </StatusBar>

        <!-- Docking area -->
        <ad:DockingManager x:Name="DockManager"
                           DocumentsSource="{Binding Documents}"
                           AnchorablesSource="{Binding Tools}"
                           ActiveContent="{Binding ActiveContent, Mode=TwoWay}"
                           AllowMixedOrientation="True">
            <ad:DockingManager.Theme>
                <adv:VS2022DarkTheme />
            </ad:DockingManager.Theme>

            <ad:DockingManager.LayoutUpdateStrategy>
                <docking:LayoutInitializer />
            </ad:DockingManager.LayoutUpdateStrategy>

            <ad:DockingManager.LayoutItemContainerStyleSelector>
                <docking:PaneStyleSelector>
                    <docking:PaneStyleSelector.ToolStyle>
                        <Style TargetType="{x:Type ad:LayoutAnchorableItem}">
                            <Setter Property="Title" Value="{Binding Model.Title}" />
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}" />
                            <Setter Property="IsSelected" Value="{Binding Model.IsSelected, Mode=TwoWay}" />
                            <Setter Property="IsActive" Value="{Binding Model.IsActive, Mode=TwoWay}" />
                            <Setter Property="Visibility" Value="{Binding Model.IsVisible, Mode=TwoWay, Converter={StaticResource BoolToHidden}}" />
                        </Style>
                    </docking:PaneStyleSelector.ToolStyle>
                    <docking:PaneStyleSelector.DocumentStyle>
                        <Style TargetType="{x:Type ad:LayoutItem}">
                            <Setter Property="Title" Value="{Binding Model.Title}" />
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}" />
                            <Setter Property="IsSelected" Value="{Binding Model.IsSelected, Mode=TwoWay}" />
                            <Setter Property="IsActive" Value="{Binding Model.IsActive, Mode=TwoWay}" />
                            <Setter Property="CloseCommand" Value="{Binding Model.CloseCommand}" />
                        </Style>
                    </docking:PaneStyleSelector.DocumentStyle>
                </docking:PaneStyleSelector>
            </ad:DockingManager.LayoutItemContainerStyleSelector>
        </ad:DockingManager>
    </DockPanel>
</Window>
