<Window x:Class="DotDeck.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:vm="clr-namespace:DotDeck.App.ViewModels"
        xmlns:docking="clr-namespace:DotDeck.App.Docking"
        xmlns:conv="clr-namespace:DotDeck.App.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="{Binding Title}"
        Width="1400" Height="860" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource DD.Brush.Chrome.Background}"
        Foreground="{DynamicResource DD.Brush.Text}"
        FontFamily="{DynamicResource DD.Font.Ui}"
        FontSize="{DynamicResource DD.FontSize.Ui}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PaneTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToHiddenConverter x:Key="BoolToHidden" />
            <BooleanToVisibilityConverter x:Key="BoolToVisible" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewScratchDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFilesCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveActiveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+S" Command="{Binding SaveActiveAsCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding ShowGlobalSearchCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="새 파일(_N)" InputGestureText="Ctrl+N" Command="{Binding NewScratchDocumentCommand}" />
                <MenuItem x:Name="TemplateMenu" Header="템플릿에서 새 파일(_T)" SubmenuOpened="OnTemplateSubmenuOpened">
                    <MenuItem Header="(없음)" IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="열기(_O)..." InputGestureText="Ctrl+O" Command="{Binding OpenFilesCommand}" />
                <Separator />
                <MenuItem Header="저장(_S)" InputGestureText="Ctrl+S" Command="{Binding SaveActiveCommand}" />
                <MenuItem Header="다른 이름으로 저장(_A)..." InputGestureText="Ctrl+Alt+S" Command="{Binding SaveActiveAsCommand}" />
                <MenuItem Header="모두 저장(_L)" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAllCommand}" />
                <MenuItem Header="백업에서 복원(_B)..." Command="{Binding RestoreBackupCommand}" />
                <Separator />
                <MenuItem Header="끝내기(_X)" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="편집(_E)">
                <MenuItem Header="전체 검색(_G)..." InputGestureText="Ctrl+Shift+F" Command="{Binding ShowGlobalSearchCommand}" />
                <Separator />
                <MenuItem Header="실행 취소(_U)" InputGestureText="Ctrl+Z" Command="Undo" />
                <MenuItem Header="다시 실행(_R)" InputGestureText="Ctrl+Y" Command="Redo" />
                <Separator />
                <MenuItem Header="잘라내기(_T)" InputGestureText="Ctrl+X" Command="Cut" />
                <MenuItem Header="복사(_C)" InputGestureText="Ctrl+C" Command="Copy" />
                <MenuItem Header="붙여넣기(_P)" InputGestureText="Ctrl+V" Command="Paste" />
                <Separator />
                <MenuItem Header="찾기(_F)" InputGestureText="Ctrl+F" Command="{Binding FindCommand}" />
                <MenuItem Header="바꾸기(_H)" InputGestureText="Ctrl+H" Command="{Binding ReplaceCommand}" />
            </MenuItem>
            <MenuItem Header="보기(_V)">
                <MenuItem Header="시작 페이지" Command="{Binding ShowWelcomeCommand}" />
                <MenuItem Header="Markdown 미리보기(_M)" InputGestureText="Ctrl+Shift+V" IsCheckable="True"
                          IsChecked="{Binding ActiveTextDocument.IsMarkdownPreviewOpen, Mode=OneWay}"
                          Command="{Binding ActiveTextDocument.ToggleMarkdownPreviewCommand}"
                          IsEnabled="{Binding ActiveTextDocument.IsMarkdown, FallbackValue=False}" />
                <Separator />
                <MenuItem Header="프로젝트" IsCheckable="True" IsChecked="{Binding Projects.IsVisible, Mode=OneWay}"
                          Command="{Binding ToggleToolCommand}" CommandParameter="{Binding Projects}" />
                <MenuItem Header="속성" IsCheckable="True" IsChecked="{Binding Properties.IsVisible, Mode=OneWay}"
                          Command="{Binding ToggleToolCommand}" CommandParameter="{Binding Properties}" />
                <MenuItem Header="출력" IsCheckable="True" IsChecked="{Binding Output.IsVisible, Mode=OneWay}"
                          Command="{Binding ToggleToolCommand}" CommandParameter="{Binding Output}" />
                <MenuItem Header="검증 결과" IsCheckable="True" IsChecked="{Binding Validation.IsVisible, Mode=OneWay}"
                          Command="{Binding ToggleToolCommand}" CommandParameter="{Binding Validation}" />
                <MenuItem Header="검색 결과" IsCheckable="True" IsChecked="{Binding SearchResults.IsVisible, Mode=OneWay}"
                          Command="{Binding ToggleToolCommand}" CommandParameter="{Binding SearchResults}" />
                <MenuItem Header="훅 테스트" IsCheckable="True" IsChecked="{Binding HookTest.IsVisible, Mode=OneWay}"
                          Command="{Binding ToggleToolCommand}" CommandParameter="{Binding HookTest}" />
                <Separator />
                <MenuItem Header="화면 공유 모드(_S)" IsCheckable="True" IsChecked="{Binding IsScreenShareMode, Mode=OneWay}"
                          Command="{Binding ToggleScreenShareModeCommand}" ToolTip="켜면 비밀값을 화면에서 가립니다" />
            </MenuItem>
            <MenuItem Header="프로젝트(_P)">
                <MenuItem Header="프로젝트 추가(_A)..." Command="{Binding Projects.AddProjectCommand}" />
                <MenuItem Header="숨긴 프로젝트 표시(_H)" ItemsSource="{Binding Projects.HiddenProjects}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Name}" />
                            <Setter Property="Command" Value="{Binding DataContext.Projects.ShowProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding Id}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="도구(_T)">
                <MenuItem Header="사용자 지정 파일 등록(경로 입력)(_G)..." Command="{Binding RegisterOtherFileCommand}" />
                <MenuItem Header="사용자 지정 파일 추가(찾아보기)(_I)..." Command="{Binding AddImportantFileCommand}" />
                <MenuItem Header="현재 파일을 사용자 지정 파일에서 빼기(_R)" Command="{Binding RemoveImportantFileCommand}" IsEnabled="{Binding HasActiveTextDocument}" />
                <Separator />
                <MenuItem Header="관리자 권한으로 다시 시작(_A)" Command="{Binding RestartAsAdministratorCommand}" />
            </MenuItem>
            <MenuItem Header="설정(_S)">
                <MenuItem Header="환경 설정(_O)..." Command="{Binding OpenSettingsCommand}" />
                <MenuItem Header="프로젝트 백업(_B)..." Command="{Binding BackupProjectsCommand}" />
            </MenuItem>
            <MenuItem Header="창(_W)">
                <MenuItem Header="새 창(_N)" Command="{Binding ActiveTextDocument.NewViewCommand}"
                          IsEnabled="{Binding HasActiveTextDocument}" ToolTip="같은 파일을 다른 탭에서 함께 편집합니다" />
                <MenuItem Header="탭 고정(_P)" IsCheckable="True" IsChecked="{Binding ActiveTextDocument.IsPinned, Mode=OneWay}"
                          Command="{Binding ActiveTextDocument.TogglePinCommand}" IsEnabled="{Binding HasActiveTextDocument}" />
                <Separator />
                <MenuItem Header="레이아웃 저장(_S)..." Click="OnSaveNamedLayoutClick" />
                <MenuItem x:Name="LoadLayoutMenu" Header="레이아웃 불러오기(_L)" SubmenuOpened="OnLayoutSubmenuOpened">
                    <MenuItem Header="(없음)" IsEnabled="False" />
                </MenuItem>
                <MenuItem x:Name="DeleteLayoutMenu" Header="레이아웃 삭제(_D)" SubmenuOpened="OnLayoutSubmenuOpened">
                    <MenuItem Header="(없음)" IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="레이아웃 초기화(_R)" Click="OnResetLayoutClick" />
            </MenuItem>
            <MenuItem Header="도움말(_H)">
                <MenuItem Header="DotDeck 정보(_A)" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar ToolBarTray.IsLocked="True">
                <Button ToolTip="새 파일 (Ctrl+N)" Command="{Binding NewScratchDocumentCommand}">
                    <TextBlock Style="{StaticResource DD.Glyph}" Text="&#xE8A5;" />
                </Button>
                <Button ToolTip="열기 (Ctrl+O)" Command="{Binding OpenFilesCommand}">
                    <TextBlock Style="{StaticResource DD.Glyph}" Text="&#xE8E5;" />
                </Button>
                <Button ToolTip="저장 (Ctrl+S)" Command="{Binding SaveActiveCommand}">
                    <TextBlock Style="{StaticResource DD.Glyph}" Text="&#xE74E;" />
                </Button>
                <Button ToolTip="모두 저장 (Ctrl+Shift+S)" Command="{Binding SaveAllCommand}">
                    <TextBlock Style="{StaticResource DD.Glyph}" Text="&#xEA35;" />
                </Button>
                <Separator />
                <Button ToolTip="실행 취소 (Ctrl+Z)" Command="Undo">
                    <TextBlock Style="{StaticResource DD.Glyph}" Text="&#xE7A7;" />
                </Button>
                <Button ToolTip="다시 실행 (Ctrl+Y)" Command="Redo">
                    <TextBlock Style="{StaticResource DD.Glyph}" Text="&#xE7A6;" />
                </Button>
            </ToolBar>
            <ToolBar ToolBarTray.IsLocked="True">
                <TextBox Width="260" IsEnabled="False" ToolTip="전역 검색 (Ctrl+Shift+F) — Phase 4" />
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.Style>
                <Style TargetType="StatusBar" BasedOn="{StaticResource {x:Type StatusBar}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSandbox}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DD.Brush.StatusBar.Sandbox}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StatusBar.Style>
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right" Content="{Binding PrivilegeStatusText}" />
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem DockPanel.Dock="Right" Padding="0">
                <Button Content="{Binding ScreenShareStatusText}" Command="{Binding ToggleScreenShareModeCommand}"
                        ToolTip="화면 공유 모드 전환 (켜면 비밀값을 화면에서 가립니다)" AutomationProperties.Name="화면 공유 모드"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource DD.Brush.Text.OnAccent}" Padding="6,0" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem DockPanel.Dock="Right" Content="{Binding HomeStatusText}" />
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem DockPanel.Dock="Right" Content="{Binding AiStatusText}" ToolTip="실행 중인 AI CLI 세션"
                           Background="{DynamicResource DD.Brush.StatusBar.AiRunning}"
                           Visibility="{Binding HasRunningAiSessions, Converter={StaticResource BoolToVisible}}" />
            <StatusBarItem DockPanel.Dock="Right" Content="{Binding ActiveTextDocument.Buffer.LineEndingText}"
                           Visibility="{Binding HasActiveTextDocument, Converter={StaticResource BoolToVisible}}" ToolTip="줄바꿈" />
            <StatusBarItem DockPanel.Dock="Right" Content="{Binding ActiveTextDocument.Buffer.EncodingText}"
                           Visibility="{Binding HasActiveTextDocument, Converter={StaticResource BoolToVisible}}" ToolTip="인코딩" />
            <StatusBarItem DockPanel.Dock="Right" Content="{Binding ActiveTextDocument.CaretText}"
                           Visibility="{Binding HasActiveTextDocument, Converter={StaticResource BoolToVisible}}" />
            <StatusBarItem DockPanel.Dock="Right" Content="{Binding LastBackupText}" MaxWidth="320"
                           ToolTip="{Binding LastBackupText}" />
            <StatusBarItem DockPanel.Dock="Right" Content="{Binding ActiveTextDocument.FilePath}" MaxWidth="420"
                           ToolTip="{Binding ActiveTextDocument.FilePath}"
                           Visibility="{Binding HasActiveTextDocument, Converter={StaticResource BoolToVisible}}" />
            <StatusBarItem Content="{Binding StatusMessage}" />
        </StatusBar>

        <!-- Docking area -->
        <ad:DockingManager x:Name="DockManager"
                           DocumentsSource="{Binding Documents}"
                           AnchorablesSource="{Binding Tools}"
                           ActiveContent="{Binding ActiveContent, Mode=TwoWay}"
                           AllowMixedOrientation="True">
            <ad:DockingManager.DocumentHeaderTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource DD.Glyph}" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"
                                   Text="&#xE718;" Visibility="{Binding Content.IsPinned, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed}" />
                        <TextBlock x:Name="HeaderText" Text="{Binding Title}" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Content.IsPreview, FallbackValue=False}" Value="True">
                            <Setter TargetName="HeaderText" Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ad:DockingManager.DocumentHeaderTemplate>

            <ad:DockingManager.LayoutUpdateStrategy>
                <docking:LayoutInitializer />
            </ad:DockingManager.LayoutUpdateStrategy>

            <ad:DockingManager.LayoutItemContainerStyleSelector>
                <docking:PaneStyleSelector>
                    <docking:PaneStyleSelector.ToolStyle>
                        <Style TargetType="{x:Type ad:LayoutAnchorableItem}">
                            <Setter Property="Title" Value="{Binding Model.Title}" />
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}" />
                            <Setter Property="IsSelected" Value="{Binding Model.IsSelected, Mode=TwoWay}" />
                            <Setter Property="IsActive" Value="{Binding Model.IsActive, Mode=TwoWay}" />
                            <Setter Property="Visibility" Value="{Binding Model.IsVisible, Mode=TwoWay, Converter={StaticResource BoolToHidden}}" />
                        </Style>
                    </docking:PaneStyleSelector.ToolStyle>
                    <docking:PaneStyleSelector.DocumentStyle>
                        <Style TargetType="{x:Type ad:LayoutItem}">
                            <Setter Property="Title" Value="{Binding Model.Title}" />
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}" />
                            <Setter Property="IsSelected" Value="{Binding Model.IsSelected, Mode=TwoWay}" />
                            <Setter Property="IsActive" Value="{Binding Model.IsActive, Mode=TwoWay}" />
                            <Setter Property="CloseCommand" Value="{Binding Model.CloseCommand}" />
                            <Setter Property="ToolTip" Value="{Binding Model.ToolTip, FallbackValue={x:Null}}" />
                            <Setter Property="CanClose" Value="{Binding Model.CanClose, FallbackValue=True}" />
                        </Style>
                    </docking:PaneStyleSelector.DocumentStyle>
                </docking:PaneStyleSelector>
            </ad:DockingManager.LayoutItemContainerStyleSelector>
        </ad:DockingManager>
    </DockPanel>
</Window>
