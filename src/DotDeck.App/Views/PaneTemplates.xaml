<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:docs="clr-namespace:DotDeck.App.ViewModels.Documents"
                    xmlns:tools="clr-namespace:DotDeck.App.ViewModels.Tools"
                    xmlns:explorer="clr-namespace:DotDeck.App.ViewModels.Explorer"
                    xmlns:explorerViews="clr-namespace:DotDeck.App.Views.Explorer"
                    xmlns:editorViews="clr-namespace:DotDeck.App.Views.Editor"
                    xmlns:conv="clr-namespace:DotDeck.App.Converters"
                    xmlns:toolViews="clr-namespace:DotDeck.App.Views.Tools">

    <BooleanToVisibilityConverter x:Key="SysBoolToVisible" />
    <conv:FalseToVisibleConverter x:Key="SysFalseToVisible" />
    <conv:NullToCollapsedConverter x:Key="SysNullToCollapsed" />

    <!-- Implicit templates: AvalonDock shows each view model through these (keyed by type). -->

    <Style x:Key="PlaceholderText" TargetType="TextBlock" BasedOn="{StaticResource DD.Text.Secondary}">
        <Setter Property="Margin" Value="12,10" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Read-only selectable value (paths on the start page) -->
    <Style x:Key="ValueText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,3" />
    </Style>

    <DataTemplate DataType="{x:Type docs:WelcomeDocumentViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource DD.Brush.Editor.Background}">
            <StackPanel Margin="32,24" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock FontSize="{DynamicResource DD.FontSize.Title}" FontWeight="Light" Text="DotDeck" />
                <TextBlock Margin="0,2,0,20" Style="{StaticResource DD.Text.Secondary}">
                    <Run Text="버전" /> <Run Text="{Binding Version, Mode=OneWay}" />
                    <Run Text=" · 개발 환경 설정 파일과 문서를 한 창에서" />
                </TextBlock>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DD.Text.Secondary}">
                            <Setter Property="Margin" Value="0,3,24,3" />
                        </Style>
                    </Grid.Resources>
                    <TextBlock Grid.Row="0" Text="모드" />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding HomeModeText, Mode=OneWay}" />
                    <TextBlock Grid.Row="1" Text="홈" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Paths.Home, Mode=OneWay}" />
                    <TextBlock Grid.Row="2" Text="Claude 전역" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Paths.ClaudeHome, Mode=OneWay}" />
                    <TextBlock Grid.Row="3" Text="Codex 전역" />
                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Paths.CodexHome, Mode=OneWay}" />
                    <TextBlock Grid.Row="4" Text="앱 데이터 (Roaming)" />
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Paths.RoamingDataDir, Mode=OneWay}" />
                    <TextBlock Grid.Row="5" Text="앱 데이터 (Local)" />
                    <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Paths.LocalDataDir, Mode=OneWay}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type docs:TextDocumentViewModel}">
        <editorViews:TextEditorView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type docs:ScratchDocumentViewModel}">
        <editorViews:UntitledEditorView />
    </DataTemplate>

    <!-- Flat button used in tool pane header bars -->
    <Style x:Key="PaneBarButton" TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
        <Setter Property="Margin" Value="1,0" />
    </Style>

    <DataTemplate DataType="{x:Type explorer:ProjectsPaneViewModel}">
        <DockPanel Background="{DynamicResource DD.Brush.Panel.Background}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,1">
                <Button Style="{StaticResource PaneBarButton}" Command="{Binding AddProjectCommand}" ToolTip="프로젝트 추가">
                    <TextBlock Style="{StaticResource DD.Glyph}" FontSize="14" Text="&#xE710;" />
                </Button>
            </StackPanel>
            <explorerViews:ExplorerListView DataContext="{Binding List}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type explorer:DetachedExplorerPaneViewModel}">
        <DockPanel Background="{DynamicResource DD.Brush.Panel.Background}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,1">
                <Button Style="{StaticResource PaneBarButton}" Command="{Binding Explorer.ReattachCommand}" ToolTip="프로젝트 영역에 다시 붙이기">
                    <TextBlock Style="{StaticResource DD.Glyph}" FontSize="14" Text="&#xE8A0;" />
                </Button>
            </StackPanel>
            <explorerViews:ExplorerListView DataContext="{Binding List}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:PropertiesPaneViewModel}">
        <Border Background="{DynamicResource DD.Brush.Panel.Background}">
            <DockPanel>
            <!-- Help for the selected settings form row (shown whether or not an item is selected) -->
            <Border DockPanel.Dock="Top" Margin="10,8,10,0" Padding="0,0,0,8" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource DD.Brush.Border}" Visibility="{Binding Help, Converter={StaticResource SysNullToCollapsed}}">
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Help.Title}" />
                        <ItemsControl ItemsSource="{Binding Help.Lines}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBox Style="{StaticResource ValueText}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding Mode=OneWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid>
                <TextBlock Style="{StaticResource PlaceholderText}" Text="선택한 항목이 없습니다."
                           Visibility="{Binding HasItem, Converter={StaticResource SysFalseToVisible}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasItem, Converter={StaticResource SysBoolToVisible}}">
                    <StackPanel Margin="10,8">
                        <TextBox Style="{StaticResource ValueText}" Text="{Binding Path, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4" TextWrapping="Wrap" Style="{StaticResource DD.Text.Secondary}" Text="{Binding Details}" />
                        <StackPanel Margin="0,6,0,0" Visibility="{Binding Role, Converter={StaticResource SysNullToCollapsed}}">
                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Role.Title}" />
                            <ItemsControl ItemsSource="{Binding Role.Lines}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Margin="0,10,0,2" FontWeight="SemiBold" Text="Windows 권한(읽기 전용)" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding Owner, StringFormat=소유자: {0}}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DD.Brush.Warning}" Text="{Binding AclError}" />
                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Rules}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock TextWrapping="Wrap">
                                            <Run FontWeight="SemiBold" Text="{Binding Identity, Mode=OneWay}" />
                                            <Run Text="{Binding Access, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding Inherited, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource DD.Text.Secondary}" Text="{Binding Rights}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            </DockPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:OutputPaneViewModel}">
        <DockPanel Background="{DynamicResource DD.Brush.Panel.Background}">
            <ToolBar DockPanel.Dock="Top" ToolBarTray.IsLocked="True" Background="{DynamicResource DD.Brush.Panel.Background}">
                <Button Command="{Binding ClearCommand}" ToolTip="모두 지우기">
                    <TextBlock Style="{StaticResource DD.Glyph}" FontSize="14" Text="&#xE894;" />
                </Button>
            </ToolBar>
            <ListBox ItemsSource="{Binding Lines}"
                     FontFamily="{DynamicResource DD.Font.Editor}" FontSize="{DynamicResource DD.FontSize.Ui}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="6,1" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:ValidationPaneViewModel}">
        <DockPanel Background="{DynamicResource DD.Brush.Panel.Background}">
            <TextBlock DockPanel.Dock="Top" Margin="6,3" Style="{StaticResource DD.Text.Secondary}" Text="{Binding Summary}" />
            <ListBox ItemsSource="{Binding Issues}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type tools:ValidationRow}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Width="18" Text="{Binding Glyph}" ToolTip="{Binding SeverityText}" />
                            <TextBlock Width="44" Style="{StaticResource DD.Text.Secondary}" Text="{Binding LineText}" />
                            <TextBlock Text="{Binding Message}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:SearchResultsPaneViewModel}">
        <toolViews:SearchPaneView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:HookTestPaneViewModel}">
        <DockPanel Background="{DynamicResource DD.Brush.Panel.Background}">
            <DockPanel DockPanel.Dock="Top" Margin="4,3">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                    <Button Style="{StaticResource PaneBarButton}" Command="{Binding RunCommand}" ToolTip="실행 (실행 전 확인)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE768;" Margin="0,0,4,0" />
                            <TextBlock Text="실행" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PaneBarButton}" Command="{Binding StopCommand}" ToolTip="중지">
                        <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE71A;" />
                    </Button>
                    <Button Style="{StaticResource PaneBarButton}" Command="{Binding ResetSampleCommand}" ToolTip="이벤트 샘플 입력으로 되돌리기">
                        <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE72C;" />
                    </Button>
                </StackPanel>
                <TextBox DockPanel.Dock="Left" Width="130" Margin="0,0,4,0" Text="{Binding Event, UpdateSourceTrigger=PropertyChanged}" ToolTip="이벤트" />
                <TextBox DockPanel.Dock="Left" Width="100" Margin="0,0,4,0" Text="{Binding Matcher, UpdateSourceTrigger=PropertyChanged}" ToolTip="matcher" />
                <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource DD.Font.Editor}" ToolTip="command" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Margin="6,0,6,3" Style="{StaticResource DD.Text.Secondary}" Text="{Binding ResultText}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="{DynamicResource DD.Font.Editor}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         ToolTip="stdin으로 전달할 이벤트 JSON" />
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource DD.Brush.Border}" />
                <TextBox Grid.Column="2" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" FontFamily="{DynamicResource DD.Font.Editor}"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </DockPanel>
    </DataTemplate>

    <!-- System documents (SPEC §8): shared header bar -->

    <DataTemplate x:Key="SystemHeader">
        <StackPanel>
            <DockPanel Margin="8,6" LastChildFill="False">
                <Button Content="추가" Command="{Binding AddCommand}" IsEnabled="{Binding CanWrite}" Margin="0,0,4,0" />
                <Button Content="적용..." Command="{Binding ApplyCommand}" IsEnabled="{Binding IsDirty}" Margin="0,0,4,0"
                        ToolTip="변경 내용을 diff로 확인한 뒤 적용합니다" />
                <Button Content="변경 취소" Command="{Binding RevertCommand}" IsEnabled="{Binding IsDirty}" Margin="0,0,4,0" />
                <Button Content="마지막 변경 되돌리기" Command="{Binding UndoCommand}" IsEnabled="{Binding CanWrite}" Margin="0,0,12,0"
                        ToolTip="백업 폴더의 변경 기록으로 되돌립니다" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource DD.Text.Secondary}" Text="{Binding ScopeText, StringFormat=범위: {0}}" />
            </DockPanel>
            <Border Background="{DynamicResource DD.Brush.Chrome.Background}" Padding="8,4"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource SysBoolToVisible}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="관리자 권한으로 다시 시작" Command="{Binding RestartAsAdministratorCommand}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="읽기 전용입니다. 시스템 범위는 관리자 권한일 때만 바꿀 수 있습니다." />
                </DockPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type docs:EnvironmentDocumentViewModel}">
        <DockPanel Background="{DynamicResource DD.Brush.Editor.Background}">
            <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource SystemHeader}" Focusable="False" />
            <DockPanel DockPanel.Dock="Top" Margin="8,0,8,6">
                <TextBlock Text="검색" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="환경변수 검색" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Margin="8,4" Style="{StaticResource DD.Text.Secondary}" TextWrapping="Wrap"
                       Text="적용 후 새로 연 터미널·프로그램부터 반영됩니다(열린 터미널에는 적용되지 않음)." />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding VisibleRows}" Margin="8,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                                         IsReadOnly="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsMasked, Converter={StaticResource SysFalseToVisible}}"
                                         IsReadOnly="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                <TextBox Grid.Column="1" Text="{Binding DisplayValue, Mode=OneWay}" IsReadOnly="True"
                                         Visibility="{Binding IsMasked, Converter={StaticResource SysBoolToVisible}}" />
                                <ToggleButton Grid.Column="2" Content="👁" Margin="4,0,0,0" IsChecked="{Binding IsRevealed}"
                                              ToolTip="비밀 값 보기/숨기기"
                                              Visibility="{Binding IsSecret, Converter={StaticResource SysBoolToVisible}}" />
                                <Button Grid.Column="3" Content="✕" Margin="4,0,0,0" ToolTip="삭제"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding Issue}" Foreground="{DynamicResource DD.Brush.Warning}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                                <Trigger Property="Text" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type docs:PathDocumentViewModel}">
        <DockPanel Background="{DynamicResource DD.Brush.Editor.Background}">
            <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource SystemHeader}" Focusable="False" />
            <DockPanel DockPanel.Dock="Top" Margin="8,0,8,6">
                <TextBlock Text="범위" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" Width="120" HorizontalAlignment="Left"
                          AutomationProperties.Name="PATH 범위" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Margin="8,4" Style="{StaticResource DD.Text.Secondary}" TextWrapping="Wrap"
                       Text="User = 사용자 PATH, Machine = 시스템 PATH. 적용 후 새로 연 터미널부터 반영됩니다." />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}" Margin="8,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                <Button Grid.Column="1" Content="▲" Margin="4,0,0,0" ToolTip="위로"
                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <Button Grid.Column="2" Content="▼" Margin="2,0,0,0" ToolTip="아래로"
                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <Button Grid.Column="3" Content="✕" Margin="2,0,0,0" ToolTip="삭제"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding Issue}" Foreground="{DynamicResource DD.Brush.Warning}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                                <Trigger Property="Text" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>
