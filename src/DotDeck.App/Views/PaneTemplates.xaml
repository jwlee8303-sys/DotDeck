<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:docs="clr-namespace:DotDeck.App.ViewModels.Documents"
                    xmlns:tools="clr-namespace:DotDeck.App.ViewModels.Tools"
                    xmlns:explorer="clr-namespace:DotDeck.App.ViewModels.Explorer"
                    xmlns:explorerViews="clr-namespace:DotDeck.App.Views.Explorer"
                    xmlns:editorViews="clr-namespace:DotDeck.App.Views.Editor">

    <!-- Implicit templates: AvalonDock shows each view model through these (keyed by type). -->

    <Style x:Key="PlaceholderText" TargetType="TextBlock" BasedOn="{StaticResource DD.Text.Secondary}">
        <Setter Property="Margin" Value="12,10" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Read-only selectable value (paths on the start page) -->
    <Style x:Key="ValueText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,3" />
    </Style>

    <DataTemplate DataType="{x:Type docs:WelcomeDocumentViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource DD.Brush.Editor.Background}">
            <StackPanel Margin="32,24" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock FontSize="{DynamicResource DD.FontSize.Title}" FontWeight="Light" Text="DotDeck" />
                <TextBlock Margin="0,2,0,20" Style="{StaticResource DD.Text.Secondary}">
                    <Run Text="버전" /> <Run Text="{Binding Version, Mode=OneWay}" />
                    <Run Text=" · 개발 환경 설정 파일과 문서를 한 창에서" />
                </TextBlock>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DD.Text.Secondary}">
                            <Setter Property="Margin" Value="0,3,24,3" />
                        </Style>
                    </Grid.Resources>
                    <TextBlock Grid.Row="0" Text="모드" />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding HomeModeText, Mode=OneWay}" />
                    <TextBlock Grid.Row="1" Text="홈" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Paths.Home, Mode=OneWay}" />
                    <TextBlock Grid.Row="2" Text="Claude 전역" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Paths.ClaudeHome, Mode=OneWay}" />
                    <TextBlock Grid.Row="3" Text="Codex 전역" />
                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Paths.CodexHome, Mode=OneWay}" />
                    <TextBlock Grid.Row="4" Text="앱 데이터 (Roaming)" />
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Paths.RoamingDataDir, Mode=OneWay}" />
                    <TextBlock Grid.Row="5" Text="앱 데이터 (Local)" />
                    <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Paths.LocalDataDir, Mode=OneWay}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type docs:TextDocumentViewModel}">
        <editorViews:TextEditorView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type docs:ScratchDocumentViewModel}">
        <editorViews:UntitledEditorView />
    </DataTemplate>

    <!-- Flat button used in tool pane header bars -->
    <Style x:Key="PaneBarButton" TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
        <Setter Property="Margin" Value="1,0" />
    </Style>

    <DataTemplate DataType="{x:Type explorer:ProjectsPaneViewModel}">
        <DockPanel Background="{DynamicResource DD.Brush.Panel.Background}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,1">
                <Button Style="{StaticResource PaneBarButton}" Command="{Binding AddProjectCommand}" ToolTip="프로젝트 추가">
                    <TextBlock Style="{StaticResource DD.Glyph}" FontSize="14" Text="&#xE710;" />
                </Button>
            </StackPanel>
            <explorerViews:ExplorerListView DataContext="{Binding List}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type explorer:DetachedExplorerPaneViewModel}">
        <DockPanel Background="{DynamicResource DD.Brush.Panel.Background}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,1">
                <Button Style="{StaticResource PaneBarButton}" Command="{Binding Explorer.ReattachCommand}" ToolTip="프로젝트 영역에 다시 붙이기">
                    <TextBlock Style="{StaticResource DD.Glyph}" FontSize="14" Text="&#xE8A0;" />
                </Button>
            </StackPanel>
            <explorerViews:ExplorerListView DataContext="{Binding List}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:PropertiesPaneViewModel}">
        <Border Background="{DynamicResource DD.Brush.Panel.Background}">
            <TextBlock Style="{StaticResource PlaceholderText}" Text="선택한 항목이 없습니다." />
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:OutputPaneViewModel}">
        <DockPanel Background="{DynamicResource DD.Brush.Panel.Background}">
            <ToolBar DockPanel.Dock="Top" ToolBarTray.IsLocked="True" Background="{DynamicResource DD.Brush.Panel.Background}">
                <Button Command="{Binding ClearCommand}" ToolTip="모두 지우기">
                    <TextBlock Style="{StaticResource DD.Glyph}" FontSize="14" Text="&#xE894;" />
                </Button>
            </ToolBar>
            <ListBox ItemsSource="{Binding Lines}"
                     FontFamily="{DynamicResource DD.Font.Editor}" FontSize="{DynamicResource DD.FontSize.Ui}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="6,1" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:ValidationPaneViewModel}">
        <DockPanel Background="{DynamicResource DD.Brush.Panel.Background}">
            <TextBlock DockPanel.Dock="Top" Margin="6,3" Style="{StaticResource DD.Text.Secondary}" Text="{Binding Summary}" />
            <ListBox ItemsSource="{Binding Issues}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type tools:ValidationRow}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Width="18" Text="{Binding Glyph}" ToolTip="{Binding SeverityText}" />
                            <TextBlock Width="44" Style="{StaticResource DD.Text.Secondary}" Text="{Binding LineText}" />
                            <TextBlock Text="{Binding Message}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:SearchResultsPaneViewModel}">
        <Border Background="{DynamicResource DD.Brush.Panel.Background}">
            <TextBlock Style="{StaticResource PlaceholderText}" Text="검색 결과가 없습니다. (Phase 4)" />
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:HookTestPaneViewModel}">
        <DockPanel Background="{DynamicResource DD.Brush.Panel.Background}">
            <DockPanel DockPanel.Dock="Top" Margin="4,3">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                    <Button Style="{StaticResource PaneBarButton}" Command="{Binding RunCommand}" ToolTip="실행 (실행 전 확인)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE768;" Margin="0,0,4,0" />
                            <TextBlock Text="실행" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PaneBarButton}" Command="{Binding StopCommand}" ToolTip="중지">
                        <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE71A;" />
                    </Button>
                    <Button Style="{StaticResource PaneBarButton}" Command="{Binding ResetSampleCommand}" ToolTip="이벤트 샘플 입력으로 되돌리기">
                        <TextBlock Style="{StaticResource DD.Glyph}" FontSize="12" Text="&#xE72C;" />
                    </Button>
                </StackPanel>
                <TextBox DockPanel.Dock="Left" Width="130" Margin="0,0,4,0" Text="{Binding Event, UpdateSourceTrigger=PropertyChanged}" ToolTip="이벤트" />
                <TextBox DockPanel.Dock="Left" Width="100" Margin="0,0,4,0" Text="{Binding Matcher, UpdateSourceTrigger=PropertyChanged}" ToolTip="matcher" />
                <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource DD.Font.Editor}" ToolTip="command" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Margin="6,0,6,3" Style="{StaticResource DD.Text.Secondary}" Text="{Binding ResultText}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="{DynamicResource DD.Font.Editor}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         ToolTip="stdin으로 전달할 이벤트 JSON" />
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource DD.Brush.Border}" />
                <TextBox Grid.Column="2" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" FontFamily="{DynamicResource DD.Font.Editor}"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
