{
  "schemaVersion": 1,
  "product": "claude",
  "productLabel": "Claude Code",
  "configDirName": ".claude",
  "managedDir": "C:\\Program Files\\ClaudeCode",
  "sources": [
    { "url": "https://code.claude.com/docs/en/claude-directory", "checked": "2026-11-08" },
    { "url": "https://code.claude.com/docs/en/settings", "checked": "2026-11-08" },
    { "url": "https://code.claude.com/docs/en/memory", "checked": "2026-11-08" },
    { "url": "https://code.claude.com/docs/en/sub-agents", "checked": "2026-11-08" },
    { "url": "https://code.claude.com/docs/en/skills", "checked": "2026-11-08" },
    { "url": "https://code.claude.com/docs/en/mcp", "checked": "2026-11-08" },
    { "url": "https://code.claude.com/docs/en/managed-settings", "checked": "2026-11-08" },
    { "url": "https://code.claude.com/docs/en/managed-mcp", "checked": "2026-11-08" }
  ],
  "nestedConfigDirNote": "하위 폴더의 .claude입니다. settings는 이 폴더에서 Claude를 시작할 때만 적용되고, skills·CLAUDE.md는 이 폴더의 파일을 다룰 때 읽힙니다.",
  "roles": {
    "settings": "설정",
    "agent": "서브에이전트",
    "skill": "스킬",
    "command": "명령(구형)",
    "rule": "규칙",
    "outputStyle": "출력 스타일",
    "memory": "메모리(CLAUDE.md)",
    "agentMemory": "서브에이전트 메모리",
    "autoMemory": "자동 메모리",
    "workflow": "워크플로",
    "keybindings": "단축키",
    "theme": "테마",
    "mcp": "MCP 서버 설정",
    "worktreeInclude": "워크트리 포함 목록",
    "appState": "앱 상태·MCP(사용자/로컬)",
    "managedSettings": "관리형 설정",
    "managedMcp": "관리형 MCP 설정"
  },
  "rules": [
    { "id": "settings", "base": "configDir", "pattern": "settings.json", "role": "settings", "editor": "settingsForm", "scope": "auto",
      "globalNotes": ["사용자 설정: 이 컴퓨터의 모든 프로젝트에 적용됩니다."],
      "projectNotes": ["공유 프로젝트 설정: 저장소에 커밋해 팀과 공유합니다. allow 규칙은 폴더를 신뢰한 뒤 적용됩니다."] },
    { "id": "settings.local", "base": "configDir", "pattern": "settings.local.json", "role": "settings", "editor": "settingsForm", "scope": "local",
      "globalNotes": ["settings.local.json은 프로젝트 전용 파일입니다. 홈 폴더를 작업 폴더로 열 때만 적용됩니다."],
      "projectNotes": ["개인 프로젝트 설정: 이 프로젝트에서 나에게만 적용되며 Git에서 제외합니다."] },
    { "id": "agents", "base": "configDir", "pattern": "agents/**/*.md", "role": "agent", "editor": "agentForm", "scope": "auto",
      "notes": ["agents 폴더는 하위 폴더까지 탐색합니다. 에이전트 이름은 파일명이 아니라 frontmatter name으로 정해집니다."] },
    { "id": "skills.synced", "base": "configDir", "pattern": "skills/synced/*/SKILL.md", "role": "skill", "editor": "skillForm", "scope": "global", "onlyIn": "global",
      "notes": ["claude.ai에서 동기화된 스킬입니다."] },
    { "id": "skills", "base": "configDir", "pattern": "skills/*/SKILL.md", "role": "skill", "editor": "skillForm", "scope": "auto" },
    { "id": "commands", "base": "configDir", "pattern": "commands/**/*.md", "role": "command", "editor": "markdown", "scope": "auto",
      "notes": ["같은 이름의 스킬이 있으면 스킬이 우선합니다. 하위 폴더는 /폴더:이름 네임스페이스가 됩니다."] },
    { "id": "rules", "base": "configDir", "pattern": "rules/**/*.md", "role": "rule", "editor": "markdown", "scope": "auto",
      "notes": ["frontmatter paths가 없으면 시작할 때, 있으면 일치하는 파일을 다룰 때 읽힙니다."] },
    { "id": "output-styles", "base": "configDir", "pattern": "output-styles/*.md", "role": "outputStyle", "editor": "markdown", "scope": "auto" },
    { "id": "claude-md.config", "base": "configDir", "pattern": "CLAUDE.md", "role": "memory", "editor": "markdown", "scope": "auto" },
    { "id": "agent-memory", "base": "configDir", "pattern": "agent-memory/**/*.md", "role": "agentMemory", "editor": "markdown", "scope": "auto" },
    { "id": "workflows", "base": "configDir", "pattern": "workflows/*.js", "role": "workflow", "editor": "text", "scope": "auto" },
    { "id": "keybindings", "base": "configDir", "pattern": "keybindings.json", "role": "keybindings", "editor": "text", "scope": "global", "onlyIn": "global" },
    { "id": "themes", "base": "configDir", "pattern": "themes/*.json", "role": "theme", "editor": "text", "scope": "global", "onlyIn": "global" },
    { "id": "auto-memory", "base": "configDir", "pattern": "projects/*/memory/*.md", "role": "autoMemory", "editor": "markdown", "scope": "global", "onlyIn": "global",
      "notes": ["MEMORY.md는 앞부분(200줄 또는 25KB)만 세션마다 읽힙니다."] },

    { "id": "app-state", "base": "home", "pattern": ".claude.json", "role": "appState", "editor": "text", "scope": "global",
      "notes": ["Claude Code가 실행 중에 자주 다시 쓰는 파일입니다. 사용자·로컬 범위 MCP 서버도 여기에 저장됩니다."] },

    { "id": "claude-md.anchor", "base": "anchorDir", "pattern": "CLAUDE.md", "role": "memory", "editor": "markdown", "scope": "project",
      "notes": ["작업 폴더와 그 상위 폴더의 CLAUDE.md는 시작할 때 읽힙니다."] },
    { "id": "claude-local-md", "base": "anyDir", "pattern": "CLAUDE.local.md", "role": "memory", "editor": "markdown", "scope": "local",
      "notes": ["개인용 지침입니다. .gitignore에 추가합니다."] },
    { "id": "mcp-json", "base": "anchorDir", "pattern": ".mcp.json", "role": "mcp", "editor": "text", "scope": "project",
      "notes": ["프로젝트 범위 MCP 서버(팀 공유)입니다."] },
    { "id": "worktreeinclude", "base": "anchorDir", "pattern": ".worktreeinclude", "role": "worktreeInclude", "editor": "text", "scope": "project" },
    { "id": "claude-md.subdir", "base": "anyDir", "pattern": "CLAUDE.md", "role": "memory", "editor": "markdown", "scope": "subdirectory",
      "notes": ["작업 폴더 아래 폴더의 CLAUDE.md는 그 폴더의 파일을 읽거나 고칠 때 읽힙니다."] },

    { "id": "managed-settings", "base": "managedDir", "pattern": "managed-settings.json", "role": "managedSettings", "editor": "settingsForm", "scope": "managed" },
    { "id": "managed-settings.d", "base": "managedDir", "pattern": "managed-settings.d/*.json", "role": "managedSettings", "editor": "settingsForm", "scope": "managed",
      "notes": ["managed-settings.json 다음에 파일 이름 순서로 합쳐집니다."] },
    { "id": "managed-mcp", "base": "managedDir", "pattern": "managed-mcp.json", "role": "managedMcp", "editor": "text", "scope": "managed" },
    { "id": "managed-claude-md", "base": "managedDir", "pattern": "CLAUDE.md", "role": "memory", "editor": "markdown", "scope": "managed" }
  ]
}
