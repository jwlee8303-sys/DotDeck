{
  "schemaVersion": 1,
  "sources": [
    { "url": "https://code.claude.com/docs/en/hooks", "checked": "2026-11-08" }
  ],
  "events": [
    { "name": "PreToolUse", "common": true, "when": "도구를 호출하기 직전(인수가 정해진 뒤)", "matcher": "tools",
      "can": "차단(종료 코드 2), 허용·거부·확인 요청·보류(permissionDecision), 입력 수정, 정보 추가", "example": "rm -rf 같은 위험한 Bash 명령을 막기" },
    { "name": "PostToolUse", "common": true, "when": "도구 호출이 성공한 뒤", "matcher": "tools",
      "can": "이미 실행됨 — 차단 불가. 결과 옆에 사유 추가(decision: block), 정보 추가, 출력 바꾸기", "example": "파일을 고친 뒤 포매터 실행" },
    { "name": "PostToolUseFailure", "when": "도구 호출이 실패한 뒤", "matcher": "tools",
      "can": "정보 추가(stderr는 Claude에 전달)", "example": "실패한 명령을 로그에 남기기" },
    { "name": "PermissionRequest", "when": "도구 호출에 권한 결정이 필요할 때", "matcher": "tools",
      "can": "허용·거부(decision.behavior), 입력·권한 수정. 종료 코드 2는 무시", "example": "특정 폴더 안 편집은 자동 허용" },
    { "name": "PermissionDenied", "when": "auto 모드가 호출을 거부했을 때", "matcher": "tools",
      "can": "retry: true로 모델이 다시 시도하게 함(거부 자체는 되돌리지 않음)", "example": "거부 사유를 알림으로 보내기" },
    { "name": "UserPromptSubmit", "common": true, "when": "사용자가 프롬프트를 제출해 처리하기 전", "matcher": "none",
      "can": "프롬프트 차단, 정보 추가, 세션 제목 지정", "example": "프롬프트에 비밀값이 있으면 막기" },
    { "name": "UserPromptExpansion", "when": "입력한 명령이 프롬프트로 펼쳐질 때", "matcher": "values", "matcherTarget": "명령 이름",
      "can": "펼치기 차단, 정보 추가", "example": "특정 슬래시 명령 사용 기록" },
    { "name": "SessionStart", "common": true, "when": "세션이 시작되거나 재개될 때", "matcher": "values", "matcherTarget": "시작 방식",
      "values": ["startup", "resume", "clear", "compact", "fork"],
      "can": "정보 추가(stdout이 문맥이 됨), 감시 경로 지정. 차단 불가. command·mcp_tool 형식만", "example": "git 상태와 할 일 목록을 문맥으로 넣기" },
    { "name": "Setup", "when": "--init-only, 또는 -p와 함께 --init/--maintenance로 실행할 때", "matcher": "values", "matcherTarget": "실행 방식",
      "values": ["init", "maintenance"], "can": "부수 효과만(JSON 출력은 버려짐). command 형식만", "example": "의존성 설치" },
    { "name": "Notification", "common": true, "when": "Claude Code가 알림을 보낼 때", "matcher": "values", "matcherTarget": "알림 종류",
      "values": ["permission_prompt", "idle_prompt", "auth_success", "auth_storage_failure", "elicitation_dialog", "elicitation_url_dialog", "elicitation_complete", "elicitation_response", "agent_needs_input", "agent_completed", "quota_auto_resume_fired", "quota_auto_resume_stale", "quota_auto_resume_disabled", "plugin_notification"],
      "can": "단순 알림(부수 효과만)", "example": "권한 요청이 오면 데스크톱 알림 띄우기" },
    { "name": "MessageDisplay", "when": "Claude의 답이 화면에 표시될 때", "matcher": "none",
      "can": "표시 내용만 바꿈(Claude가 보는 내용은 그대로), 차단 불가", "example": "출력의 특정 단어 강조" },
    { "name": "SubagentStart", "when": "서브에이전트가 시작·재개될 때", "matcher": "values", "matcherTarget": "에이전트 종류",
      "values": ["Explore", "Plan", "general-purpose"], "can": "정보 추가, 차단 불가", "example": "서브에이전트에 프로젝트 규칙 주입" },
    { "name": "SubagentStop", "common": true, "when": "서브에이전트가 끝날 때", "matcher": "values", "matcherTarget": "에이전트 종류",
      "values": ["Explore", "Plan", "general-purpose"], "can": "종료 막기(decision: block, 계속 작업), 정보 추가", "example": "결과 검증 후 부족하면 계속 진행" },
    { "name": "TaskCreated", "when": "TaskCreate로 작업이 만들어질 때", "matcher": "none",
      "can": "차단(작업 삭제)", "example": "작업 이름 규칙 검사" },
    { "name": "TaskCompleted", "when": "작업이 완료로 표시될 때", "matcher": "none",
      "can": "완료 막기(종료 코드 2)", "example": "테스트가 통과해야 완료 허용" },
    { "name": "Stop", "common": true, "when": "Claude가 응답을 마칠 때(사용자 중단 제외)", "matcher": "none",
      "can": "종료 막기(decision: block, 계속 작업, 최대 8회), 정보 추가", "example": "빌드가 실패하면 고치도록 계속 진행" },
    { "name": "StopFailure", "when": "API 오류로 턴이 끝날 때(Stop 대신)", "matcher": "values", "matcherTarget": "오류 종류", "pipeOnly": true,
      "values": ["rate_limit", "overloaded", "authentication_failed", "billing_error", "invalid_request", "model_not_found", "server_error", "max_output_tokens"],
      "can": "출력 무시 — 단순 알림", "example": "사용량 한도 알림" },
    { "name": "TeammateIdle", "when": "에이전트 팀원이 대기 상태가 되려 할 때", "matcher": "none",
      "can": "계속 작업하게 함(종료 코드 2)", "example": "남은 작업이 있으면 계속" },
    { "name": "InstructionsLoaded", "when": "CLAUDE.md나 .claude/rules/*.md를 읽었을 때", "matcher": "values", "matcherTarget": "읽은 이유",
      "values": ["session_start", "nested_traversal", "path_glob_match", "include", "compact"], "can": "관찰만(부수 효과)", "example": "어떤 지침이 읽혔는지 기록" },
    { "name": "ConfigChange", "when": "세션 중 설정 파일이 바뀔 때", "matcher": "values", "matcherTarget": "설정 종류",
      "values": ["user_settings", "project_settings", "local_settings", "policy_settings", "skills"], "can": "변경 차단(policy_settings 제외)", "example": "권한 설정이 바뀌면 막기" },
    { "name": "CwdChanged", "when": "작업 폴더가 바뀔 때(cd 등)", "matcher": "none",
      "can": "부수 효과, 감시 경로 지정", "example": "폴더별 환경 변수 불러오기" },
    { "name": "DirectoryAdded", "when": "/add-dir 등으로 폴더가 추가될 때", "matcher": "values", "matcherTarget": "추가 방식",
      "values": ["slash_command", "register_repo_root"], "can": "부수 효과, 차단 불가", "example": "추가 폴더 기록" },
    { "name": "FileChanged", "when": "감시 중인 파일이 디스크에서 바뀔 때", "matcher": "values", "matcherTarget": "파일 이름", "pipeOnly": true, "fileNames": true,
      "values": [".envrc", ".env"], "can": "부수 효과, 차단 불가", "example": ".envrc가 바뀌면 환경 다시 불러오기" },
    { "name": "WorktreeCreate", "when": "워크트리를 만들 때", "matcher": "none",
      "can": "기본 git 동작을 대신함(0이 아닌 종료 코드는 생성 실패)", "example": "사용자 정의 워크트리 생성" },
    { "name": "WorktreeRemove", "when": "워크트리를 지울 때", "matcher": "none",
      "can": "폴더가 남아 있으면 0이 아닌 종료 코드로 삭제 실패", "example": "워크트리 정리" },
    { "name": "PreCompact", "common": true, "when": "대화를 압축하기 전", "matcher": "values", "matcherTarget": "압축 방식",
      "values": ["manual", "auto"], "can": "압축 차단, stdout이 압축 지침이 됨", "example": "압축 전에 대화 기록 저장" },
    { "name": "PostCompact", "when": "대화를 압축한 뒤", "matcher": "values", "matcherTarget": "압축 방식",
      "values": ["manual", "auto"], "can": "부수 효과", "example": "압축 후 핵심 문맥 다시 알림" },
    { "name": "PreModelSwitch", "when": "요청한 모델 전환 직전", "matcher": "values", "matcherTarget": "모델 이름",
      "values": ["claude-opus-5"], "can": "전환 허용·거부·확인 요청, 차단", "example": "비싼 모델로 바꿀 때 확인" },
    { "name": "PostModelSwitch", "when": "세션 모델이 바뀐 뒤", "matcher": "values", "matcherTarget": "모델 이름",
      "values": ["claude-opus-5"], "can": "정보 추가, 차단 불가", "example": "모델 변경 기록" },
    { "name": "Elicitation", "when": "MCP 서버가 사용자 입력을 요청할 때", "matcher": "values", "matcherTarget": "MCP 서버 이름",
      "can": "수락·거절·취소, 내용 채우기", "example": "정해진 값으로 자동 응답" },
    { "name": "ElicitationResult", "when": "사용자가 MCP 입력 요청에 답한 뒤", "matcher": "values", "matcherTarget": "MCP 서버 이름",
      "can": "응답 차단(거절로 바뀜)", "example": "응답 내용 검사" },
    { "name": "PostToolBatch", "when": "병렬 도구 호출 묶음이 끝나고 다음 모델 호출 전", "matcher": "none",
      "can": "루프 중단(decision: block 또는 continue: false), 정보 추가", "example": "여러 파일 수정 뒤 한 번에 검사" },
    { "name": "SessionEnd", "common": true, "when": "세션이 끝날 때", "matcher": "values", "matcherTarget": "종료 이유",
      "values": ["clear", "resume", "logout", "prompt_input_exit", "other"], "can": "부수 효과만(기본 제한 시간 1.5초)", "example": "세션 요약을 파일로 저장" }
  ]
}
