    { "key": "plan_mode_reasoning_effort", "label": "계획 모드 추론 수준", "description": "계획 모드에 적용할 추론 수준입니다.", "default": "계획 모드 기본값", "choices": [ { "value": "low", "description": "낮음" }, { "value": "medium", "description": "중간" }, { "value": "high", "description": "높음" }, { "value": "xhigh", "description": "더 높음" }, { "value": "max", "description": "최대" }, { "value": "ultra", "description": "ultra" } ] },
